---
import { getCollection } from 'astro:content';
import HeroReviewSlider from '@/components/HeroReviewSlider.astro';

const reviews = (await getCollection('reviews')).sort(
  (a, b) => b.data.reviewDate.valueOf() - a.data.reviewDate.valueOf(),
);
const reviewCount = reviews.length;
const avg =
  reviewCount === 0
    ? 5
    : Math.round((reviews.reduce((sum, r) => sum + r.data.rating, 0) / reviewCount) * 10) / 10;
---

<!-- Full-bleed Hero -->
<section class="w-full relative overflow-hidden bg-[hsl(240_50%_11%)]" data-ps="src/components/reviews/ReviewsHero.astro:ux6vyx">
  <div class="relative min-h-[460px] md:min-h-[500px] flex items-center w-full" data-ps="src/components/reviews/ReviewsHero.astro:9wmewv">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/19072266-a54c-45c1-93fc-083938698d93_compressed_geo-page-heat-pump-repairs-in-portland-mi-geo-page-main-imag-1024-1024.webp"
      alt="Customer Reviews for JT's Heating Cooling & Plumbing"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/reviews/ReviewsHero.astro:cevj8f" />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/reviews/ReviewsHero.astro:9wmewu"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 w-full z-10 relative" data-ps="src/components/reviews/ReviewsHero.astro:9wmew8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center w-full" data-ps="src/components/reviews/ReviewsHero.astro:9wmew7">
        <div class="lg:col-span-7 flex flex-col items-start text-left" data-ps="src/components/reviews/ReviewsHero.astro:9wmew6">
          <span class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6 backdrop-blur-sm" data-ps="src/components/reviews/ReviewsHero.astro:90qpbt">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/reviews/ReviewsHero.astro:90qpbu"></span>
            Verified Customer Reviews
          </span>
          <h1 class="text-[36px] sm:text-[46px] md:text-[50px] font-semibold leading-[1.28] sm:leading-[1.3] tracking-[-1.2px] text-white m-0 mb-4" data-ps="src/components/reviews/ReviewsHero.astro:bp43as">
            What West Michigan <span class="inline-block bg-white text-primary px-2.5 py-0 rounded-lg italic font-semibold" data-ps="src/components/reviews/ReviewsHero.astro:90qpbv">says about JT.</span>
          </h1>
          <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.625] max-w-[580px] mb-8 font-normal" data-ps="src/components/reviews/ReviewsHero.astro:7l8rt3">
            {avg.toFixed(1)} stars across {reviewCount} Google reviews — real homeowners, real heating, cooling & plumbing work, zero pressure.
          </p>
          <div class="flex flex-wrap items-center gap-4" data-ps="src/components/reviews/ReviewsHero.astro:9wmew5">
            <a href="/book/" class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline" data-ps="src/components/reviews/ReviewsHero.astro:hav42">
              <span data-ps="src/components/reviews/ReviewsHero.astro:90qpch">Book a Visit</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
            <a href="/contact/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm" data-ps="src/components/reviews/ReviewsHero.astro:hav41">
              Contact JT
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center lg:justify-end w-full" data-ps="src/components/reviews/ReviewsHero.astro:cardcol">
          <HeroReviewSlider />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Content Body -->
<section class="bg-[hsl(45_33%_98%)] py-16 sm:py-20" data-ps="src/components/reviews/ReviewsHero.astro:ux6vyw">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/reviews/ReviewsHero.astro:9wmew3">
    <!-- Trust Badges Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-[900px] mx-auto mb-12" data-ps="src/components/reviews/ReviewsHero.astro:9wmew2">
      <div class="bg-white border border-[hsl(45_12%_93%)] rounded-2xl p-5 flex items-center gap-3 shadow-sm" data-ps="src/components/reviews/ReviewsHero.astro:9wmew1">
        <svg class="w-10 h-10 text-[hsl(210_100%_29%)] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div data-ps="src/components/reviews/ReviewsHero.astro:9wmew0">
          <div class="text-[14px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmevz">Licensed & insured</div>
          <div class="text-[12px] text-[hsl(240_4%_36%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmevd">Michigan contractor</div>
        </div>
      </div>
      <div class="bg-white border border-[hsl(45_12%_93%)] rounded-2xl p-5 flex items-center gap-3 shadow-sm" data-ps="src/components/reviews/ReviewsHero.astro:9wmevc">
        <svg class="w-10 h-10 text-[hsl(210_100%_29%)] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <div data-ps="src/components/reviews/ReviewsHero.astro:9wmevb">
          <div class="text-[14px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmeva">Call for availability</div>
          <div class="text-[12px] text-[hsl(240_4%_36%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmev9">(616) 840-3105</div>
        </div>
      </div>
      <div class="bg-white border border-[hsl(45_12%_93%)] rounded-2xl p-5 flex items-center gap-3 shadow-sm" data-ps="src/components/reviews/ReviewsHero.astro:9wmev8">
        <svg class="w-10 h-10 text-[hsl(210_100%_29%)] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <div data-ps="src/components/reviews/ReviewsHero.astro:9wmev7">
          <div class="text-[14px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmev6">{avg.toFixed(1)} · {reviewCount} reviews</div>
          <div class="text-[12px] text-[hsl(240_4%_36%)]" data-ps="src/components/reviews/ReviewsHero.astro:9wmev5">Local & owner-operated</div>
        </div>
      </div>
    </div>

    <!-- Rating Summary Card -->
    <div class="max-w-[600px] mx-auto bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-8 text-center mb-16 shadow-sm" data-ps="src/components/reviews/ReviewsHero.astro:9wmev4">
      <div class="text-[64px] font-bold text-[hsl(210_100%_29%)] leading-none mb-2" data-ps="src/components/reviews/ReviewsHero.astro:bi54o">{avg.toFixed(1)}</div>
      <div class="flex items-center justify-center gap-1 mb-3" data-ps="src/components/reviews/ReviewsHero.astro:bi54n">
        <svg class="w-5 h-5 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg class="w-5 h-5 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg class="w-5 h-5 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg class="w-5 h-5 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg class="w-5 h-5 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <div class="text-[16px] text-[hsl(240_4%_36%)] mb-6" data-ps="src/components/reviews/ReviewsHero.astro:bi54m">Based on {reviewCount} verified Google reviews</div>
      <a href="/book/" class="bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-7 py-3.5 text-[16px] font-semibold inline-flex items-center gap-2 transition-colors no-underline" data-ps="src/components/reviews/ReviewsHero.astro:hav40">
        Book your visit
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/components/reviews/ReviewsHero.astro:bi54l">
      {reviews.map((review, __psIdx) => (
        <article class="bg-white border border-[hsl(45_12%_93%)] rounded-[24px] p-6 hover:shadow-lg transition-all duration-300" data-ps={`src/components/reviews/ReviewsHero.astro:sv9w54-${__psIdx}`}>
          <div class="flex items-center gap-3 mb-4" data-ps={`src/components/reviews/ReviewsHero.astro:bi54k-${__psIdx}`}>
            <div class="w-12 h-12 rounded-full bg-[hsl(210_100%_29%)] text-white flex items-center justify-center text-[18px] font-bold flex-shrink-0" data-ps={`src/components/reviews/ReviewsHero.astro:bi54j-${__psIdx}`}>
              {review.data.author.charAt(0).toUpperCase()}
            </div>
            <div data-ps={`src/components/reviews/ReviewsHero.astro:bi54i-${__psIdx}`}>
              <div class="text-[15px] font-semibold text-[hsl(240_4%_9%)]" data-ps={`src/components/reviews/ReviewsHero.astro:bi54h-${__psIdx}`}>{review.data.author}</div>
              <div class="text-[12px] text-[hsl(240_4%_36%)]" data-ps={`src/components/reviews/ReviewsHero.astro:bi54g-${__psIdx}`}>
                Verified Google review · {review.data.reviewDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 mb-4" data-ps={`src/components/reviews/ReviewsHero.astro:bi54f-${__psIdx}`}>
            {Array.from({ length: Math.round(review.data.rating) }).map(() => (
              <svg class="w-4 h-4 text-[#fbbf24]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <blockquote class="text-[14px] text-[hsl(240_4%_36%)] leading-[1.6] m-0">
            "{review.data.body}"
          </blockquote>
        </article>
      ))}
    </div>
  </div>
</section>
