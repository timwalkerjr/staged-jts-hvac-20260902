---
const reviews = [
  { name: 'Jim', initial: 'J', quote: "Jordan was fantastic. He came out quickly, explained everything along the way, and we had A/C again during the heat wave! Use JT's!!!!!", date: 'Aug 2026' },
  { name: 'David Rosner', initial: 'D', quote: "Jordan is, without a doubt, one of the best HVAC professionals I've ever worked with. His knowledge and expertise are exceptional, and he takes the time to thoroughly explain the problem and the best solution without ever making you feel pressured.", date: 'Jul 2026' },
  { name: 'Charissa Hunter', initial: 'C', quote: "Jordan was very knowledgeable and professional. He was able to give us some energy saving tips. I highly recommend him!", date: 'Jul 2026' },
  { name: 'Roxy C', initial: 'R', quote: "Great experience with JT's Heating Cooling and Plumbing. Quick response, fair pricing, and our AC was fixed the same day. Honest, professional service with excellent communication throughout the process.", date: 'Jul 2026' },
  { name: 'Mary McCarty', initial: 'M', quote: "Excellent service and great guy! I reached out to him at 7am and he was at my house at 10am and was quick to fix my AC issue. Even provided tips to keep it working and charge was very reasonable. He is now my go-to for heating & cooling!", date: 'Jul 2026' },
  { name: 'Lacey T', initial: 'L', quote: "Had Jordan out for a quote and he was great! Very kind and helpful, got to the house quickly and communicated well! From my interaction so far, it's been great!", date: 'Jul 2026' },
  { name: 'Jenn Love-Kippen', initial: 'J', quote: "Jordan did a fantastic job doing our yearly AC inspection and tune-up. I have already committed to having him back out in the Fall for our furnace maintenance. He is friendly, knowledgeable, thorough, and his prices are excellent. Highly recommend!", date: 'Jul 2026' },
  { name: 'Amelia Pavelka', initial: 'A', quote: "Such a wonderful experience with JT's Heating, Cooling & Plumbing! From the very beginning, I experienced prompt, professional and personable communication and service. Even on the hottest day of 2026, Jordan worked effectively, efficiently, and expertly on installation of my new air and heating systems.", date: 'Jul 2026' },
  { name: 'Tran Ho', initial: 'T', quote: "JT's was recommended to us by Angie's List which setup my meeting with Jordan who was a pleasure to speak with. I barely knew anything about hvac, but he patiently walked me through all concerns and put me at ease with his insights and transparency.", date: 'Jul 2026' },
  { name: 'Aaron', initial: 'A', quote: "Don't let the small number of reviews stop you from using JT's, this new company is awesome. Fast, professional and super fair rates. I had a gas leak and they quickly detected the problem areas, made the repairs, and done!", date: 'Jul 2026' },
  { name: 'Russell V', initial: 'R', quote: "My in laws had an old fuel oil Furnace and water heater and wanted to switch to natural gas. They got several quotes and chose JT and couldn't be more pleased. He installed a whole new gas line, furnace, water heater, and Ac.", date: 'Jul 2026' },
  { name: 'Senada Delic', initial: 'S', quote: "Jordan did an excellent job installing my new furnace and A/C unit. He was very professional, knowledgeable, and took the time to explain everything I needed to know. I could tell he takes pride in his work—he is detail-oriented, careful, and truly a perfectionist.", date: 'Jul 2026' },
  { name: 'Ian Barrie', initial: 'I', quote: "JT diagnosed our AC issue in just minutes. He has the diagnostic tools and even shows you the report. A stand up, honest guy. Call JT.", date: 'Jul 2026' },
  { name: 'Jamaica Walston', initial: 'J', quote: "The owner is the technician and has a fine personality and friendliness. His prices are reasonable, the products he uses our quality and he backs his work up. He will give you options and doesn't try to sell you the most expensive thing he has to offer.", date: 'Jul 2026' },
  { name: 'Liam Cunningham', initial: 'L', quote: "JT was very professional and knowledgeable. He gave me the unfortunate diagnosis of needing both a new AC unit and furnace, but gave me the confidence that it was the right thing to do. Never did I feel like he was trying to oversell.", date: 'Jun 2026' },
  { name: 'Elizabeth Gallagher', initial: 'E', quote: "JT was prompt in responding to call and arrival was spot on with the time he gave. He explained the issues we were having with our AC using verbiage that we understood. We will definitely be calling for future needs.", date: 'Jun 2026' },
  { name: 'Nancy Golin', initial: 'N', quote: "Jordan from JT heating and cooling came to our home in Zeeland and tuned up and serviced our AC unit. He was very professional and knowledgeable and offered options to improve the efficiency of our older unit. He didn't try to upsell or try to persuade us to get a new system like big companies often try to do.", date: 'Jun 2026' },
  { name: 'Gary H', initial: 'G', quote: "Jordan did an amazing job installing my dryer vent duct work!! A very professional, friendly and knowledgeable young man!! I would highly recommend and will be using him again for future projects.", date: 'Jun 2026' },
  { name: 'Leigh Hower', initial: 'L', quote: "Jordan is hard-working, conscientious, and knowledgeable. I'm glad to have JT's Heating Cooling & Plumbing as my new go-to!", date: 'Jun 2026' },
  { name: 'Ken Valkenburg', initial: 'K', quote: "JT is great! He was very respectful of our time, explained our options thoroughly, and got everything done well in the time allotted. He's also kind and great to work with. I highly recommend him for your HVAC needs.", date: 'Jun 2026' },
  { name: 'nik', initial: 'N', quote: "Prompt, professional, and personable. Jordan explains the process well. The price is excellent.", date: 'Jun 2026' },
  { name: 'Joel Gritter', initial: 'J', quote: "Had a great experience working with Jordan/JT's! The work was done very well and professionally. Jordan was good at communicating on timing and on what was being done. Felt very comfortable with him and very happy with the results!", date: 'Jun 2026' },
  { name: 'Christopher Anderson', initial: 'C', quote: "Jordan did an amazing job on our AC unit tune-up. Very professional and reasonably priced. We will definitely be using his services again going forward and would highly recommend to anyone in need of HVAC service.", date: 'Jun 2026' },
  { name: 'Jakob Jackson', initial: 'J', quote: "JT has worked on multiple projects at our home and at family members homes. He is a great guy to work with, does great work and he is very friendly! I also appreciated clear communication and easy to understand and reasonable pricing!", date: 'Jun 2026' },
  { name: 'Dan Mitchell', initial: 'D', quote: "Jordan was introduced by a contractor. Although not in his normal service area he agreed to move an outside unit to a new location running new lines in a basement ceiling. Realized unit was old and no longer effective. Installed a new unit on a cold wintery day in Dec.", date: 'Jun 2026' },
  { name: 'Courtney Moskal', initial: 'C', quote: "JT is an honest trustworthy young man that came out to check on my A/C. I definitely will use him again.", date: 'Jun 2026' },
  { name: 'Joan Gregg', initial: 'J', quote: "Prompt efficient and honest. Quoted a fair price compared to other companies and quickly had my A/C back up and running.", date: 'Jun 2026' },
];
---

<!-- Full-bleed Hero -->
