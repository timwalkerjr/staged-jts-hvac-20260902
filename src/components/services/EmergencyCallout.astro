<section class="bg-[hsl(45_18%_96%)] py-20">
  <div class="max-w-[1400px] mx-auto px-4">
    <div class="bg-[hsl(240_50%_11%)] rounded-[32px] overflow-hidden grid grid-cols-1 lg:grid-cols-2 relative">
      <div class="p-8 md:p-14 text-white flex flex-col justify-center">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/25 text-white text-[11px] font-semibold px-3 py-1.5 rounded-full mb-6 uppercase tracking-wider w-fit">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 4.5L18.5 19h-13L12 6.5zM11 11v3h2v-3h-2zm0 4v2h2v-2h-2z"/></svg>
          Emergency
        </div>
        <h2 class="text-[32px] md:text-[42px] font-semibold tracking-tight leading-[1.15] mb-6">
          No heat or water leak <span class="italic text-[hsl(211_100%_70%)]">emergency?</span>
        </h2>
        <p class="text-[16px] text-white/80 leading-[1.625] mb-8 max-w-[480px]">
          If it's a gas leak or safety issue, call 911 and your utility company first. For no-heat emergencies or major water leaks, call me directly.
        </p>
        <a
          href="tel:+16168403105"
          class="inline-flex items-center gap-3 bg-[hsl(210_100%_29%)] hover:bg-[hsl(210_100%_22%)] text-white rounded-full px-7 py-4 text-[18px] font-bold transition-colors w-fit"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (616) 840-3105
        </a>
      </div>
      <div class="relative min-h-[320px] lg:min-h-0">
        <img
          src="https://pagesmith-cdn.com/381bbb8d/images/ca9ee066a1687101b3a751fface7c5b9-1536-1536.webp"
          alt="JT's technician installing a thermostat in a Michigan home"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
