---
---

<section class="bg-[hsl(45_33%_98%)] py-20">
  <div class="max-w-[1400px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Planning ahead card -->
    <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8 md:p-12 flex flex-col justify-between">
      <div>
        <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-3 py-1.5 rounded-full mb-6 uppercase tracking-wider">
          Planning ahead?
        </div>
        <h2 class="text-[28px] md:text-[36px] font-semibold tracking-tight leading-[1.2] text-[hsl(240_4%_9%)] mb-6">
          Get practical options <span class="italic text-[hsl(210_100%_29%)]">before you commit.</span>
        </h2>
        <p class="text-[16px] text-[hsl(240_4%_36%)] leading-[1.625] mb-8 max-w-[480px]">
          Whether the system needs service now or replacement should be discussed, JT will explain what makes sense and why—without a pushy sales process.
        </p>
      </div>
      <a
        href="/book/"
        class="inline-flex items-center gap-2 bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-7 py-3.5 text-[16px] font-semibold transition-colors w-fit"
      >
        Request a call
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
    </div>

    <!-- Not sure card -->
    <div class="bg-[hsl(211_100%_95%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8 md:p-12 flex flex-col justify-between">
      <div>
        <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-3 py-1.5 rounded-full mb-6 uppercase tracking-wider">
          Not sure what you need?
        </div>
        <h2 class="text-[28px] md:text-[36px] font-semibold tracking-tight leading-[1.2] text-[hsl(240_4%_9%)] mb-6">
          Let's talk it through, <span class="italic text-[hsl(210_100%_29%)]">no pressure.</span>
        </h2>
        <p class="text-[16px] text-[hsl(240_4%_36%)] leading-[1.625] mb-8 max-w-[480px]">
          Send a few details about what's going on and I'll point you in the right direction.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/book/"
          class="inline-flex items-center gap-2 bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-7 py-3.5 text-[16px] font-semibold transition-colors"
        >
          Book a visit
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 border border-[hsl(45_12%_93%)] bg-white text-[hsl(240_4%_9%)] rounded-full px-7 py-3.5 text-[16px] font-semibold hover:border-[hsl(210_100%_29%)] transition-colors"
        >
          Send a message
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
