---
const reviews = [
  { quote: "Jordan was fantastic. He came out quickly, explained everything along the way, and we had A/C again during the heat wave! Use JT's!!!!!", author: "Jim", meta: "Verified Google review" },
  { quote: "Jordan was very knowledgeable and professional. He was able to give us some energy saving tips. I highly recommend him!", author: "Charissa Hunter", meta: "Verified Google review" },
  { quote: "Had Jordan out for a quote and he was great! Very kind and helpful, got to the house quickly and communicated well! From my interaction so far, it's been great!", author: "Lacey T", meta: "Verified Google review" },
  { quote: "JT diagnosed our AC issue in just minutes. He has the diagnostic tools and even shows you the report. A stand up, honest guy. Call JT.", author: "Ian Barrie", meta: "Verified Google review" }
];
---
<section class="bg-[hsl(45_18%_96%)]" data-ps="src/components/about/AboutReviews.astro:ceq2q8">
  <div class="max-w-[1400px] mx-auto px-4 py-24 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center" data-ps="src/components/about/AboutReviews.astro:16ygw9">
    <div class="lg:col-span-7" data-ps="src/components/about/AboutReviews.astro:16ygwa">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="64" height="64" fill="rgb(0, 74, 148)" class="mb-6 opacity-30"><path d="M3 17h3v-3H4v-1q0-.825.588-1.413T6 11V9q-1.65 0-2.825 1.175T2 13v4zm9 0h3v-3h-2v-1q0-.825.588-1.413T15 11V9q-1.65 0-2.825 1.175T11 13v4z"/></svg>
      <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] rounded-full px-4 py-1.5 text-[12px] font-semibold mb-6" data-ps="src/components/about/AboutReviews.astro:16ygwb">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="oklch(0.828 0.189 84.429)"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        5.0 · 31 Google reviews
      </div>
      <div class="space-y-6" data-ps="src/components/about/AboutReviews.astro:knru59">
        {reviews.map((review, __psIdx) => (
          <blockquote class="border-l-4 border-[hsl(210_100%_29%)] pl-6 py-2">
            <p class="text-[18px] md:text-[20px] font-medium leading-[1.4] text-[hsl(240_4%_9%)] mb-3" data-ps={`src/components/about/AboutReviews.astro:1xj51c-${__psIdx}`}>{review.quote}</p>
            <footer class="flex items-center gap-2" data-ps={`src/components/about/AboutReviews.astro:7zwptt-${__psIdx}`}>
              <span class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps={`src/components/about/AboutReviews.astro:kyabya-${__psIdx}`}>— {review.author}</span>
              <span class="text-[14px] text-[hsl(240_4%_36%)]" data-ps={`src/components/about/AboutReviews.astro:kyabyb-${__psIdx}`}>· {review.meta}</span>
              <span class="flex items-center gap-0.5 ml-2" data-ps={`src/components/about/AboutReviews.astro:kyabyc-${__psIdx}`}>
                {[1,2,3,4,5].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="oklch(0.828 0.189 84.429)"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                ))}
              </span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
    <div class="lg:col-span-5" data-ps="src/components/about/AboutReviews.astro:knru5a">
      <div class="bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/about/AboutReviews.astro:knru5b">
        <div class="space-y-6" data-ps="src/components/about/AboutReviews.astro:knru5c">
          <div class="flex items-center gap-3 pb-6 border-b border-[hsl(45_12%_93%)]" data-ps="src/components/about/AboutReviews.astro:knru5d">
            <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-[hsl(210_100%_29%)] flex items-center justify-center" data-ps="src/components/about/AboutReviews.astro:knru5e">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
            </div>
            <div data-ps="src/components/about/AboutReviews.astro:knru5f">
              <p class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/about/AboutReviews.astro:1xj51b">Licensed & insured</p>
              <p class="text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/about/AboutReviews.astro:1xj51a">Call for availability</p>
            </div>
          </div>
          <div class="flex items-center gap-3 pb-6 border-b border-[hsl(45_12%_93%)]" data-ps="src/components/about/AboutReviews.astro:knru5g">
            <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-[hsl(210_100%_29%)] flex items-center justify-center" data-ps="src/components/about/AboutReviews.astro:knru5h">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </div>
            <div data-ps="src/components/about/AboutReviews.astro:knru5i">
              <p class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/about/AboutReviews.astro:1xj519">5.0 · 31 reviews</p>
              <p class="text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/about/AboutReviews.astro:1xj518">Local & owner-operated</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
