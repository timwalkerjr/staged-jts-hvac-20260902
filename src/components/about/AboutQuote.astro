---
---
<section class="bg-[hsl(45_33%_98%)]">
  <div class="max-w-[1400px] mx-auto px-4 py-24">
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] rounded-full px-3 py-1 text-[11px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)]"></span>
        In my own words
      </span>
      <h2 class="text-[36px] md:text-[48px] font-semibold tracking-tight mt-4">
        A quote from <span class="italic text-[hsl(210_100%_29%)]">me.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7">
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="80" height="80" fill="hsl(210 100% 29% / 0.15)" class="absolute -top-6 -left-4">
            <path d="M3 17h3v-3H4v-1q0-.825.588-1.413T6 11V9q-1.65 0-2.825 1.175T2 13v4zm9 0h3v-3h-2v-1q0-.825.588-1.413T15 11V9q-1.65 0-2.825 1.175T11 13v4z"/>
          </svg>
          <blockquote class="text-[24px] md:text-[32px] font-medium leading-[1.4] text-[hsl(240_4%_9%)] relative pl-8">
            I focus on listening first and selling second. You tell me what's going on with your system, I'll diagnose it honestly, and we'll talk through whether repair or replacement actually makes sense for your home.
          </blockquote>
          <div class="mt-8 flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-[hsl(210_100%_29%)] text-white flex items-center justify-center text-[24px] font-semibold">
              JT
            </div>
            <div>
              <p class="text-[18px] font-semibold text-[hsl(240_4%_9%)]">JT</p>
              <p class="text-[14px] text-[hsl(240_4%_36%)]">Owner · JT'S HOME SERVICES LLC · Grand Rapids, MI</p>
            </div>
          </div>
          <div class="mt-6 inline-flex items-center gap-2 bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-full px-4 py-1.5 text-[12px] font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="oklch(0.828 0.189 84.429)"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            5.0 · Verified locally
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-[32px] overflow-hidden shadow-lg aspect-[4/5]">
          <img
            src="https://pagesmith-cdn.com/381bbb8d/images/3251f536-2b91-426f-bdcc-f8de96e067d9_compressed_jt-owner-hero-1024-1024.webp"
            alt="Portrait of JT, the local HVAC technician"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
