---
import { SITE } from '@/config/site';
---

<section id="hero" class="w-full relative overflow-hidden" data-ps="src/components/home/Hero.astro:ah8lbd">
  <div class="relative min-h-[600px] lg:min-h-[640px] flex items-center w-full" data-ps="src/components/home/Hero.astro:iy4taa">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/19072266-a54c-45c1-93fc-083938698d93_compressed_geo-page-heat-pump-repairs-in-portland-mi-geo-page-main-imag-1024-1024.webp"
      alt="JT, owner of JT's Heating Cooling & Plumbing, standing outdoors in West Michigan"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/home/Hero.astro:gfvoys" />

    <!-- Exact Gradient Overlay from Design Spec -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/home/Hero.astro:iy4tab"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24 w-full z-10 relative" data-ps="src/components/home/Hero.astro:iy4tac">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full" data-ps="src/components/home/Hero.astro:ecxgfc">
      <!-- Left Column -->
      <div class="lg:col-span-7 flex flex-col items-start" data-ps="src/components/home/Hero.astro:iy4tad">
        <!-- H1 Headline (First text in hero) -->
        <h1 class="font-semibold text-white leading-[1.18] tracking-[-1.2px] m-0 mb-4 text-[48px]" data-ps="src/components/home/Hero.astro:307k0y">
          Honest Heating, Cooling & Plumbing for <span class="inline-block bg-white text-primary px-2.5 py-0.5 rounded-lg italic font-semibold" data-ps="src/components/home/Hero.astro:z1i1yd">West Michigan</span> Homes & Families.
        </h1>

        <!-- Badges Row -->
        <div class="flex flex-wrap items-center gap-3 mb-6" data-ps="src/components/home/Hero.astro:iy4tae">
          <div class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full flex items-center gap-2 backdrop-blur-sm" data-ps="src/components/home/Hero.astro:iy4taf">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/home/Hero.astro:z1i1yb"></span>
            <span data-ps="src/components/home/Hero.astro:z1i1ya">Serving Grand Rapids & West MI</span>
          </div>

          <div class="bg-white/10 border border-white/25 text-white/95 text-[12px] font-medium px-3.5 py-1.5 rounded-full flex items-center gap-1.5 backdrop-blur-sm" data-ps="src/components/home/Hero.astro:iy4tag">
            <span class="text-amber-300 text-[14px]" data-ps="src/components/home/Hero.astro:z1i1y9">★</span>
            <span data-ps="src/components/home/Hero.astro:z1i1y8">5.0 · 31 Google reviews</span>
          </div>
        </div>

        <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.6] max-w-[580px] mb-8 font-normal" data-ps="src/components/home/Hero.astro:6uyknz">
          No pressure, no upsells — just straight talk about what your home actually needs. Licensed and insured, owner-operated right here in Grand Rapids.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4" data-ps="src/components/home/Hero.astro:iy4tah">
          <a
            href="/book/"
            class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline"
           data-ps="src/components/home/Hero.astro:8zc09">
            <span data-ps="src/components/home/Hero.astro:z1i1y7">Book a Visit</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </a>

          <a
            href="/pricing/"
            class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm"
           data-ps="src/components/home/Hero.astro:8zc0a">
            <span data-ps="src/components/home/Hero.astro:z1i1y6">Request a Quote</span>
          </a>
        </div>
      </div>

      <!-- Right Column: 3 Quick Action Cards -->
      <div class="lg:col-span-5 flex flex-col gap-3.5 w-full" data-ps="src/components/home/Hero.astro:ecxgf3">
        <!-- Card 1 -->
        <a
          href="/book/"
          class="bg-white text-foreground rounded-2xl p-5 shadow-xl border border-black/5 hover:border-primary transition-all no-underline block group"
         data-ps="src/components/home/Hero.astro:8zc0b">
          <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Hero.astro:ecxgf4">
            <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf5">
              <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0" data-ps="src/components/home/Hero.astro:ecxgf6">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                </svg>
              </div>
              <h2 class="font-semibold group-hover:text-primary-hover transition-colors m-0 text-[rgb(0,74,148)] text-[16px]" data-ps="src/components/home/Hero.astro:bo7d6p">
                No heat? I need furnace repair
              </h2>
            </div>
            <span class="text-[9px] uppercase font-bold tracking-wider bg-[hsl(210_100%_29%/0.1)] text-primary px-2.5 py-1 rounded-full whitespace-nowrap" data-ps="src/components/home/Hero.astro:z1i1y5">
              CALL FOR AVAILABILITY
            </span>
          </div>
          <p class="text-[13px] text-muted-foreground leading-relaxed m-0 pl-13" data-ps="src/components/home/Hero.astro:6uykny">
            Furnace won't start, making weird noises, or blowing cold air? Talk me through what's happening and I'll come check it out.
          </p>
        </a>

        <!-- Card 2 -->
        <a
          href="/book/"
          class="bg-white text-foreground rounded-2xl p-5 shadow-xl border border-black/5 hover:border-primary transition-all no-underline block group"
         data-ps="src/components/home/Hero.astro:8zc0c">
          <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Hero.astro:ecxgf7">
            <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf8">
              <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0" data-ps="src/components/home/Hero.astro:ecxgf9">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="font-semibold text-primary group-hover:text-primary-hover transition-colors m-0 text-[16px]" data-ps="src/components/home/Hero.astro:bo7d6o">
                A/C not cooling? I need service
              </h2>
            </div>
            <span class="text-[9px] uppercase font-bold tracking-wider bg-[hsl(210_100%_29%/0.1)] text-primary px-2.5 py-1 rounded-full whitespace-nowrap" data-ps="src/components/home/Hero.astro:z1i1xj">
              CALL FOR A QUOTE
            </span>
          </div>
          <p class="text-[13px] text-muted-foreground leading-relaxed m-0 pl-13" data-ps="src/components/home/Hero.astro:6uyknx">
            Central air blowing warm or barely working? I'll diagnose what's going on and give you straight answers — repair or replace.
          </p>
        </a>

        <!-- Card 3 -->
        <a
          href="/book/"
          class="bg-white text-foreground rounded-2xl p-5 shadow-xl border border-black/5 hover:border-primary transition-all no-underline block group"
         data-ps="src/components/home/Hero.astro:8zc0y">
          <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Hero.astro:ecxgfa">
            <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgfb">
              <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0" data-ps="src/components/home/Hero.astro:ecxgfc">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h2 class="font-semibold group-hover:text-primary-hover transition-colors m-0 text-[rgb(0,74,148)] text-[16px]" data-ps="src/components/home/Hero.astro:bo7d6n">
                I need a new system installed
              </h2>
            </div>
            <span class="text-[9px] uppercase font-bold tracking-wider bg-[hsl(210_100%_29%/0.1)] text-primary px-2.5 py-1 rounded-full whitespace-nowrap" data-ps="src/components/home/Hero.astro:z1i1xi">
              INSTALLATION ESTIMATES
            </span>
          </div>
          <p class="text-[13px] text-muted-foreground leading-relaxed m-0 pl-13" data-ps="src/components/home/Hero.astro:6uyknw">
            Ready for a new furnace, A/C, heat pump, mini-split, or water heater? Honest sizing, clear pricing, clean install.
          </p>
        </a>
      </div>
    </div>
    </div>
  </div>
</section>
