---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const sortedReviews = [...allReviews].sort(
  (a, b) => b.data.reviewDate.valueOf() - a.data.reviewDate.valueOf(),
);
const reviewCount = allReviews.length;
const featuredReviews = sortedReviews.slice(0, 6);
---

<section id="reviews" class="max-w-[1400px] mx-auto px-4 py-20 sm:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center" data-ps="src/components/home/Testimonials.astro:rdr5t6">
  <!-- Left Column: Reviews slider -->
  <div class="lg:col-span-7 flex flex-col items-start" data-ps="src/components/home/Testimonials.astro:rl25j7">
    <!-- Top Quote Icon & Badge -->
    <div class="flex items-center gap-4 mb-6" data-ps="src/components/home/Testimonials.astro:rl25j8">
      <svg class="w-12 h-12 text-[hsl(210_100%_29%/0.2)] flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
      </svg>
      <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] text-foreground text-[12px] font-semibold px-3 py-1.5 rounded-full shadow-sm" data-ps="src/components/home/Testimonials.astro:rl25j9">
        <span class="text-amber-400" data-ps="src/components/home/Testimonials.astro:pdgp6d">★</span>
        <span data-ps="src/components/home/Testimonials.astro:pdgp6e">5.0 · {reviewCount} GOOGLE REVIEWS</span>
      </div>
    </div>

    <!-- Testimonial Slides Container -->
    <div class="w-full relative min-h-[220px]" data-ps="src/components/home/Testimonials.astro:rl25jv">
      {featuredReviews.map((review, idx) => (
        <div class:list={["testimonial-slide transition-opacity duration-300", idx === 0 ? "block" : "hidden"]} data-index={idx} data-ps={`src/components/home/Testimonials.astro:slide-${idx}`}>
          <blockquote class="text-[20px] sm:text-[23px] md:text-[25px] font-medium leading-[1.4] text-foreground m-0 mb-6">
            "{review.data.body}"
          </blockquote>
          <div class="flex items-center justify-between flex-wrap gap-2" data-ps={`src/components/home/Testimonials.astro:slide-meta-${idx}`}>
            <div data-ps={`src/components/home/Testimonials.astro:slide-author-${idx}`}>
              <span class="text-[17px] font-semibold text-foreground block" data-ps={`src/components/home/Testimonials.astro:jsx5kd-${idx}`}>{review.data.author}</span>
              <span class="text-[13px] text-muted-foreground block" data-ps={`src/components/home/Testimonials.astro:jsx5kc-${idx}`}>Verified Google review · {review.data.reviewDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            </div>
            <div class="flex text-amber-400 text-sm" data-ps={`src/components/home/Testimonials.astro:jqcpxu-${idx}`}>
              {Array.from({ length: Math.round(review.data.rating) }).map((__psIdx2) => (
                <span data-ps={`src/components/home/Testimonials.astro:jsx5kb-${__psIdx2}`}>★</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Controls Row -->
    <div class="flex items-center justify-between w-full mt-8 pt-6 border-t border-[hsl(45_12%_93%)]" data-ps="src/components/home/Testimonials.astro:jqcpxy">
      <!-- Dots Indicator -->
      <div class="flex items-center gap-2" id="testimonial-dots" data-ps="src/components/home/Testimonials.astro:jqcpxx">
        {featuredReviews.map((_, idx) => (
          <button type="button" class:list={["w-2.5 h-2.5 rounded-full transition-all dot-btn", idx === 0 ? "bg-primary" : "bg-[hsl(45_12%_93%)]"]} aria-label={`Go to slide ${idx + 1}`} data-ps={`src/components/home/Testimonials.astro:dot-${idx}`}></button>
        ))}
      </div>

      <!-- Arrow Buttons -->
      <div class="flex items-center gap-3" data-ps="src/components/home/Testimonials.astro:jqcpxw">
        <button
          id="prev-testimonial"
          type="button"
          class="w-10 h-10 rounded-full border border-[hsl(45_12%_93%)] bg-white flex items-center justify-center text-foreground hover:border-primary hover:text-primary transition-colors shadow-sm"
          aria-label="Previous testimonial"
         data-ps="src/components/home/Testimonials.astro:ii0b4z">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button
          id="next-testimonial"
          type="button"
          class="w-10 h-10 rounded-full border border-[hsl(45_12%_93%)] bg-white flex items-center justify-center text-foreground hover:border-primary hover:text-primary transition-colors shadow-sm"
          aria-label="Next testimonial"
         data-ps="src/components/home/Testimonials.astro:ii0b4y">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <a
      href="/reviews/"
      class="text-[14px] font-semibold text-primary mt-6 hover:underline inline-flex items-center gap-1.5 no-underline"
     data-ps="src/components/home/Testimonials.astro:v3pdsp">
      <span data-ps="src/components/home/Testimonials.astro:pdgp7c">Read all {reviewCount} reviews</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
      </svg>
    </a>
  </div>

  <!-- Right Column: Image -->
  <div class="lg:col-span-5" data-ps="src/components/home/Testimonials.astro:jqcpxv">
    <div class="rounded-[32px] overflow-hidden shadow-2xl aspect-[4/5] w-full" data-ps="src/components/home/Testimonials.astro:jqcpxu">
      <img
        src="https://pagesmith-cdn.com/381bbb8d/images/5f0852eec03568e5bd7c5ddb0aca2662-1024-1024.webp"
        alt="Satisfied JT's Heating Cooling & Plumbing customers in their Grand Rapids home"
        class="w-full h-full object-cover"
        loading="lazy" data-ps="src/components/home/Testimonials.astro:p2t17p" />
    </div>
  </div>
</section>

<script is:inline>
  const slides = document.querySelectorAll('.testimonial-slide');
  const dots = document.querySelectorAll('.dot-btn');
  const prevBtn = document.getElementById('prev-testimonial');
  const nextBtn = document.getElementById('next-testimonial');
  let currentIndex = 0;

  function showSlide(index) {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;
    currentIndex = index;

    slides.forEach((slide, i) => {
      if (i === currentIndex) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
      } else {
        slide.classList.add('hidden');
        slide.classList.remove('block');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentIndex) {
        dot.classList.remove('bg-[hsl(45_12%_93%)]');
        dot.classList.add('bg-primary');
      } else {
        dot.classList.add('bg-[hsl(45_12%_93%)]');
        dot.classList.remove('bg-primary');
      }
    });
  }

  prevBtn?.addEventListener('click', () => showSlide(currentIndex - 1));
  nextBtn?.addEventListener('click', () => showSlide(currentIndex + 1));
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => showSlide(i));
  });
</script>
