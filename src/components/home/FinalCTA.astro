---
// Final CTA Section
---

<section id="cta" class="w-full bg-[hsl(211_100%_95%)] border-t border-primary/15 py-16 sm:py-24 px-4 sm:px-6" data-ps="src/components/home/FinalCTA.astro:wzpud9">
  <div class="max-w-[1400px] mx-auto flex flex-col items-center text-center" data-ps="src/components/home/FinalCTA.astro:whsoti">
    <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-4 py-1.5 rounded-full mb-6" data-ps="src/components/home/FinalCTA.astro:whsotj">
      <span class="w-1.5 h-1.5 rounded-full bg-primary" data-ps="src/components/home/FinalCTA.astro:u1v8tb"></span>
      <span data-ps="src/components/home/FinalCTA.astro:lxz4zr">READY WHEN YOU ARE</span>
    </div>

    <h2 class="font-semibold text-foreground leading-[1.2] tracking-tight m-0 max-w-[700px] text-[36px] sm:text-[44px] md:text-[48px]" data-ps="src/components/home/FinalCTA.astro:l1x9kk">
      Local heating & cooling, <span class="italic text-primary block" data-ps="src/components/home/FinalCTA.astro:lxz4zs">just around the corner.</span>
    </h2>

    <p class="text-[16px] sm:text-[18px] text-muted-foreground max-w-[560px] mt-4 mb-8" data-ps="src/components/home/FinalCTA.astro:2nltjv">
      Send a request in under a minute, or call JT for current availability.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4" data-ps="src/components/home/FinalCTA.astro:whsotk">
      <a
        href="/book/"
        class="bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-8 py-4 text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline"
       data-ps="src/components/home/FinalCTA.astro:46qhcp">
        <span data-ps="src/components/home/FinalCTA.astro:lxz4zt">Book a Visit</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>

      <a
        href="/pricing/"
        class="border border-[hsl(45_12%_93%)] bg-white text-foreground rounded-full px-8 py-4 text-[16px] font-semibold hover:border-primary transition-colors no-underline flex items-center gap-2"
       data-ps="src/components/home/FinalCTA.astro:46qhco">
        <span data-ps="src/components/home/FinalCTA.astro:lxz4zu">Request a Quote</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
