---
// Pricing Table Section
---

<section id="pricing" class="bg-[hsl(45_18%_96%)] py-20 sm:py-24 border-y border-[hsl(45_12%_93%)]" data-ps="src/components/home/PricingTable.astro:yzy72g">
  <div class="max-w-[1400px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start" data-ps="src/components/home/PricingTable.astro:sjurrl">
    <!-- Left Column -->
    <div class="lg:col-span-5 flex flex-col items-start" data-ps="src/components/home/PricingTable.astro:sjurrm">
      <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-3 py-1 rounded-full mb-4" data-ps="src/components/home/PricingTable.astro:sjurrn">
        <span data-ps="src/components/home/PricingTable.astro:uswy4x">CLEAR QUOTES</span>
      </div>

      <h2 class="font-semibold text-foreground leading-[1.2] tracking-tight m-0 mb-4 text-[48px]" data-ps="src/components/home/PricingTable.astro:hy0qah">
        Honest pricing, <span class="italic text-primary block" data-ps="src/components/home/PricingTable.astro:uswy4y">clearly written.</span>
      </h2>

      <p class="text-[16px] sm:text-[18px] text-muted-foreground leading-relaxed m-0 mb-8 max-w-[480px]" data-ps="src/components/home/PricingTable.astro:2tdpjs">
        Every home and system is different. JT will look at what is happening, explain the practical options, and give you a clear quote before any work begins.
      </p>

      <div class="flex flex-wrap items-center gap-4" data-ps="src/components/home/PricingTable.astro:sjurro">
        <a
          href="/#services"
          class="bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-8 py-4 text-[15px] font-semibold flex items-center gap-2 shadow-md transition-all no-underline"
         data-ps="src/components/home/PricingTable.astro:9xbm8n">
          <span data-ps="src/components/home/PricingTable.astro:uswy4z">Check Availability</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>

        <a
          href="/#faq"
          class="border border-[hsl(45_12%_93%)] bg-white text-foreground rounded-full px-8 py-4 text-[15px] font-semibold hover:border-primary transition-colors no-underline flex items-center gap-2"
         data-ps="src/components/home/PricingTable.astro:9xbm8o">
          <span data-ps="src/components/home/PricingTable.astro:uswy5l">Quote details</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Pricing Rows -->
    <div class="lg:col-span-7 bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-6 sm:p-8 shadow-sm" data-ps="src/components/home/PricingTable.astro:sjurrp">
      <div class="flex items-center justify-between pb-3 border-b border-[hsl(45_12%_93%)] text-[11px] font-bold text-muted-foreground tracking-wider uppercase" data-ps="src/components/home/PricingTable.astro:sjurrq">
        <span data-ps="src/components/home/PricingTable.astro:uswy5m">SERVICE</span>
        <span data-ps="src/components/home/PricingTable.astro:uswy5n">PRICING</span>
      </div>

      <div class="divide-y divide-[hsl(45_12%_93%)]" data-ps="src/components/home/PricingTable.astro:sjurrr">
        <!-- Row 1 -->
        <div class="py-4.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2" data-ps="src/components/home/PricingTable.astro:sjurrs">
          <div class="flex items-start gap-3" data-ps="src/components/home/PricingTable.astro:sjurse">
            <div class="w-8 h-8 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:sjursf">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
            </div>
            <div data-ps="src/components/home/PricingTable.astro:sjursg">
              <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[18px]" data-ps="src/components/home/PricingTable.astro:wmfnir">Furnace diagnostic</h3>
              <p class="text-[13px] text-muted-foreground m-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:2tdpke">Thorough inspection and honest diagnosis of any furnace issue.</p>
            </div>
          </div>
          <span class="text-[14px] font-semibold text-primary sm:text-right pl-11 sm:pl-0" data-ps="src/components/home/PricingTable.astro:uswy5o">Call for a Quote</span>
        </div>

        <!-- Row 2 -->
        <div class="py-4.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2" data-ps="src/components/home/PricingTable.astro:sjursh">
          <div class="flex items-start gap-3" data-ps="src/components/home/PricingTable.astro:sjursi">
            <div class="w-8 h-8 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:sjursj">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div data-ps="src/components/home/PricingTable.astro:sjursk">
              <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[18px]" data-ps="src/components/home/PricingTable.astro:wmfniq">A/C diagnostic</h3>
              <p class="text-[13px] text-muted-foreground m-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:2tdpkf">Full system check to find out why your A/C isn't cooling properly.</p>
            </div>
          </div>
          <span class="text-[14px] font-semibold text-primary sm:text-right pl-11 sm:pl-0" data-ps="src/components/home/PricingTable.astro:uswy5p">Call for a Quote</span>
        </div>

        <!-- Row 3 -->
        <div class="py-4.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2" data-ps="src/components/home/PricingTable.astro:sjursl">
          <div class="flex items-start gap-3" data-ps="src/components/home/PricingTable.astro:sjursm">
            <div class="w-8 h-8 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:sjursn">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div data-ps="src/components/home/PricingTable.astro:wzzc8h">
              <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[18px]" data-ps="src/components/home/PricingTable.astro:wmfnip">Furnace installation</h3>
              <p class="text-[13px] text-muted-foreground m-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:2tdpkg">Full replacement with proper sizing -- no overselling, just the right unit.</p>
            </div>
          </div>
          <span class="text-[14px] font-semibold text-primary sm:text-right pl-11 sm:pl-0" data-ps="src/components/home/PricingTable.astro:uswy5q">Call for a Quote</span>
        </div>

        <!-- Row 4 -->
        <div class="py-4.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2" data-ps="src/components/home/PricingTable.astro:wzzc8i">
          <div class="flex items-start gap-3" data-ps="src/components/home/PricingTable.astro:wzzc8j">
            <div class="w-8 h-8 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:wzzc8k">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div data-ps="src/components/home/PricingTable.astro:wzzc8l">
              <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[18px]" data-ps="src/components/home/PricingTable.astro:wmfnio">A/C service & tune-up</h3>
              <p class="text-[13px] text-muted-foreground m-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:2tdpkh">Clean coils, check refrigerant, test performance -- keeps your system running right.</p>
            </div>
          </div>
          <span class="text-[14px] font-semibold text-primary sm:text-right pl-11 sm:pl-0" data-ps="src/components/home/PricingTable.astro:uswy5r">Call for a Quote</span>
        </div>

        <!-- Row 5 -->
        <div class="py-4.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2" data-ps="src/components/home/PricingTable.astro:wzzc8m">
          <div class="flex items-start gap-3" data-ps="src/components/home/PricingTable.astro:wzzc8n">
            <div class="w-8 h-8 rounded-full bg-[hsl(210_100%_29%/0.1)] text-primary flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:wzzc8o">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <div data-ps="src/components/home/PricingTable.astro:wzzc8p">
              <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[18px]" data-ps="src/components/home/PricingTable.astro:wmfnin">Water heater replacement</h3>
              <p class="text-[13px] text-muted-foreground m-0 mt-0.5" data-ps="src/components/home/PricingTable.astro:2tdpki">Gas, electric or tankless -- I'll help you choose what works best for your home.</p>
            </div>
          </div>
          <span class="text-[14px] font-semibold text-primary sm:text-right pl-11 sm:pl-0" data-ps="src/components/home/PricingTable.astro:uswy5s">Call for a Quote</span>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[hsl(45_12%_93%)] flex items-center gap-2 text-[12px] text-muted-foreground" data-ps="src/components/home/PricingTable.astro:wzzc8q">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span data-ps="src/components/home/PricingTable.astro:uswy5t">Final cost depends on the equipment and scope. You'll always receive a quote before the job starts.</span>
      </div>
    </div>
  </div>
</section>
