---
// Service Area Grid Section
---

<section id="area" class="bg-[hsl(45_18%_96%)] py-20 sm:py-24 border-y border-[hsl(45_12%_93%)]" data-ps="src/components/home/ServiceAreaGrid.astro:vtzi6z">
  <div class="max-w-[1400px] mx-auto px-4" data-ps="src/components/home/ServiceAreaGrid.astro:5suxn0">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6" data-ps="src/components/home/ServiceAreaGrid.astro:5suxme">
      <div data-ps="src/components/home/ServiceAreaGrid.astro:5suxmd">
        <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-3 py-1 rounded-full mb-4" data-ps="src/components/home/ServiceAreaGrid.astro:5suxmc">
          <span data-ps="src/components/home/ServiceAreaGrid.astro:o90ws3">WHERE WE WORK</span>
        </div>
        <h2 class="font-semibold text-foreground leading-[1.2] tracking-tight m-0 text-[48px]" data-ps="src/components/home/ServiceAreaGrid.astro:p9b85i">
          Serving <span class="italic text-primary" data-ps="src/components/home/ServiceAreaGrid.astro:o90ws2">Grand Rapids</span> and <br class="hidden sm:inline" />West Michigan homes & businesses.
        </h2>
      </div>

      <a
        href="/#area"
        class="inline-flex items-center gap-2 border border-[hsl(45_12%_93%)] bg-white text-foreground rounded-full px-6 py-3.5 text-[15px] font-semibold hover:border-primary transition-colors no-underline self-start md:self-end flex-shrink-0"
       data-ps="src/components/home/ServiceAreaGrid.astro:n4kuj8">
        <span data-ps="src/components/home/ServiceAreaGrid.astro:o90wrg">See service area</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-ps="src/components/home/ServiceAreaGrid.astro:5suxmb">
      <!-- Card 1 -->
      <div class="bg-[hsl(45_33%_98%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden p-3 hover:shadow-xl transition-all duration-300 group" data-ps="src/components/home/ServiceAreaGrid.astro:5suxma">
        <div class="h-[200px] rounded-[24px] overflow-hidden mb-4" data-ps="src/components/home/ServiceAreaGrid.astro:5suxm9">
          <img
            src="https://pagesmith-cdn.com/381bbb8d/images/1430bc1d1a6368af376e246c66a87060-1024-1024.webp"
            alt="Grand Rapids"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy" data-ps="src/components/home/ServiceAreaGrid.astro:8b41yl" />
        </div>
        <div class="px-3 pb-3" data-ps="src/components/home/ServiceAreaGrid.astro:5suxm8">
          <div class="flex items-baseline justify-between mb-1.5" data-ps="src/components/home/ServiceAreaGrid.astro:5suxm7">
            <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[24px]" data-ps="src/components/home/ServiceAreaGrid.astro:akwax9">Grand Rapids</h3>
            <span class="text-[12px] font-semibold text-muted-foreground" data-ps="src/components/home/ServiceAreaGrid.astro:o90wrf">49503 · 49505</span>
          </div>
          <p class="text-[14px] text-muted-foreground m-0" data-ps="src/components/home/ServiceAreaGrid.astro:g0mxu7">
            Home base -- call for current availability.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-[hsl(45_33%_98%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden p-3 hover:shadow-xl transition-all duration-300 group" data-ps="src/components/home/ServiceAreaGrid.astro:5suxm6">
        <div class="h-[200px] rounded-[24px] overflow-hidden mb-4" data-ps="src/components/home/ServiceAreaGrid.astro:5suxm5">
          <img
            src="https://pagesmith-cdn.com/381bbb8d/images/1b40c8d9493c040849576be631d10da0-1024-1024.webp"
            alt="Kentwood"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy" data-ps="src/components/home/ServiceAreaGrid.astro:8b41yk" />
        </div>
        <div class="px-3 pb-3" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ydx">
          <div class="flex items-baseline justify-between mb-1.5" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ydy">
            <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[24px]" data-ps="src/components/home/ServiceAreaGrid.astro:akwaxv">Kentwood</h3>
            <span class="text-[12px] font-semibold text-muted-foreground" data-ps="src/components/home/ServiceAreaGrid.astro:o90wre">49508 · 49512</span>
          </div>
          <p class="text-[14px] text-muted-foreground m-0" data-ps="src/components/home/ServiceAreaGrid.astro:g0mxu8">
            Family neighborhoods and suburban homes.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-[hsl(45_33%_98%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden p-3 hover:shadow-xl transition-all duration-300 group" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ydz">
        <div class="h-[200px] rounded-[24px] overflow-hidden mb-4" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye0">
          <img
            src="https://pagesmith-cdn.com/381bbb8d/images/8f9ee504c8755e8d94ca6fb1ead68ad9-1024-1024.webp"
            alt="Wyoming"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy" data-ps="src/components/home/ServiceAreaGrid.astro:8b41yj" />
        </div>
        <div class="px-3 pb-3" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye1">
          <div class="flex items-baseline justify-between mb-1.5" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye2">
            <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[24px]" data-ps="src/components/home/ServiceAreaGrid.astro:akwaxw">Wyoming</h3>
            <span class="text-[12px] font-semibold text-muted-foreground" data-ps="src/components/home/ServiceAreaGrid.astro:o90wrd">49509 · 49519</span>
          </div>
          <p class="text-[14px] text-muted-foreground m-0" data-ps="src/components/home/ServiceAreaGrid.astro:g0mxu9">
            Heating, cooling, and water heater help.
          </p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-[hsl(45_33%_98%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden p-3 hover:shadow-xl transition-all duration-300 group" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye3">
        <div class="h-[200px] rounded-[24px] overflow-hidden mb-4" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye4">
          <img
            src="https://pagesmith-cdn.com/381bbb8d/images/86bc8bb2bf53e3942070afba8978acb0-1024-1024.webp"
            alt="Rockford & North"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy" data-ps="src/components/home/ServiceAreaGrid.astro:8b41yi" />
        </div>
        <div class="px-3 pb-3" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye5">
          <div class="flex items-baseline justify-between mb-1.5" data-ps="src/components/home/ServiceAreaGrid.astro:mq4ye6">
            <h3 class="font-semibold m-0 text-[rgb(22,22,24)] text-[24px]" data-ps="src/components/home/ServiceAreaGrid.astro:akwaxx">Rockford & North</h3>
            <span class="text-[12px] font-semibold text-muted-foreground" data-ps="src/components/home/ServiceAreaGrid.astro:o90wrc">49341 · 49321</span>
          </div>
          <p class="text-[14px] text-muted-foreground m-0" data-ps="src/components/home/ServiceAreaGrid.astro:g0mxua">
            Homes, cabins and lakeside properties up north.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
