---
// About / Owner Section
---

<section id="about" class="bg-[hsl(45_18%_96%)] py-20 sm:py-24 border-y border-[hsl(45_12%_93%)]" data-ps="src/components/home/AboutOwner.astro:ijqay3">
  <div class="max-w-[1400px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center" data-ps="src/components/home/AboutOwner.astro:k51or6">
    <!-- Left Column: Story, stats, trust badges -->
    <div class="lg:col-span-6 flex flex-col items-start" data-ps="src/components/home/AboutOwner.astro:k51or5">
      <div class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] text-[hsl(240_4%_36%)] text-[11px] font-semibold px-3 py-1 rounded-full mb-4" data-ps="src/components/home/AboutOwner.astro:k51or4">
        <span data-ps="src/components/home/AboutOwner.astro:nlglkn">OWNER-OPERATED · LICENSED · INSURED</span>
      </div>

      <h2 class="font-semibold text-foreground leading-[1.2] tracking-tight m-0 mb-4 text-[48px]" data-ps="src/components/home/AboutOwner.astro:o4p4k2">
        One local technician <span class="italic text-primary block" data-ps="src/components/home/AboutOwner.astro:nlglkm">who listens before he quotes.</span>
      </h2>

      <p class="text-[16px] sm:text-[18px] text-muted-foreground leading-relaxed m-0 mb-8 max-w-[560px]" data-ps="src/components/home/AboutOwner.astro:xc3fv7">
        No call centres, no commissioned salespeople, no surprise fees. Just honest heating, cooling and plumbing by someone who lives and works right here in West Michigan.
      </p>

      <!-- Stat Grid -->
      <div class="grid grid-cols-3 gap-6 sm:gap-8 w-full border-y border-[hsl(45_12%_93%)] py-6 mb-8" data-ps="src/components/home/AboutOwner.astro:k51or3">
        <div data-ps="src/components/home/AboutOwner.astro:k51or2">
          <span class="block text-[22px] sm:text-[26px] font-bold text-foreground" data-ps="src/components/home/AboutOwner.astro:nlglkl">Local</span>
          <span class="block text-[11px] font-semibold tracking-wider text-muted-foreground uppercase mt-0.5" data-ps="src/components/home/AboutOwner.astro:nlglkk">WEST MICHIGAN SERVICE</span>
        </div>
        <div data-ps="src/components/home/AboutOwner.astro:k51or1">
          <span class="block text-[22px] sm:text-[26px] font-bold text-foreground" data-ps="src/components/home/AboutOwner.astro:nlglkj">Direct</span>
          <span class="block text-[11px] font-semibold tracking-wider text-muted-foreground uppercase mt-0.5" data-ps="src/components/home/AboutOwner.astro:nlglki">TALK WITH JT</span>
        </div>
        <div data-ps="src/components/home/AboutOwner.astro:k51or0">
          <span class="block text-[22px] sm:text-[26px] font-bold text-foreground" data-ps="src/components/home/AboutOwner.astro:nlglkh">Clear</span>
          <span class="block text-[11px] font-semibold tracking-wider text-muted-foreground uppercase mt-0.5" data-ps="src/components/home/AboutOwner.astro:nlgljv">OPTIONS BEFORE WORK</span>
        </div>
      </div>

      <!-- Trust Badges Row -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3" data-ps="src/components/home/AboutOwner.astro:k51oqz">
        <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] px-3.5 py-1.5 rounded-full text-[13px] font-medium text-foreground" data-ps="src/components/home/AboutOwner.astro:gosua5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-ps="src/components/home/AboutOwner.astro:nlglju">Fully licensed</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] px-3.5 py-1.5 rounded-full text-[13px] font-medium text-foreground" data-ps="src/components/home/AboutOwner.astro:gosua4">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-ps="src/components/home/AboutOwner.astro:nlgljt">Fully insured</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] px-3.5 py-1.5 rounded-full text-[13px] font-medium text-foreground" data-ps="src/components/home/AboutOwner.astro:gosua3">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-ps="src/components/home/AboutOwner.astro:nlgljs">Owner-operated</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] px-3.5 py-1.5 rounded-full text-[13px] font-medium text-foreground" data-ps="src/components/home/AboutOwner.astro:gosua2">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-ps="src/components/home/AboutOwner.astro:nlgljr">No-pressure pricing</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] px-3.5 py-1.5 rounded-full text-[13px] font-medium text-foreground" data-ps="src/components/home/AboutOwner.astro:gosua1">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-ps="src/components/home/AboutOwner.astro:nlgljq">Clean workmanship</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Owner portrait -->
    <div class="lg:col-span-6" data-ps="src/components/home/AboutOwner.astro:gosua0">
      <div class="relative rounded-[32px] overflow-hidden shadow-2xl aspect-[4/3] w-full" data-ps="src/components/home/AboutOwner.astro:gosu9z">
        <img
          src="https://pagesmith-cdn.com/381bbb8d/images/jt-owner-1024.webp"
          alt="Portrait of JT, owner of JT's Heating Cooling & Plumbing"
          class="w-full h-full object-cover object-top"
          loading="lazy" data-ps="src/components/home/AboutOwner.astro:mnat2o" />

        <!-- Floating bottom card -->
        <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6" data-ps="src/components/home/AboutOwner.astro:gosu9y">
          <div class="bg-black/60 backdrop-blur-md border border-white/20 rounded-2xl p-4 text-white flex items-center justify-between" data-ps="src/components/home/AboutOwner.astro:gosu9x">
            <div data-ps="src/components/home/AboutOwner.astro:gosu9w">
              <span class="text-[16px] sm:text-[18px] font-bold text-white block" data-ps="src/components/home/AboutOwner.astro:nlgljp">
                Jordan Miller "JT"
              </span>
              <span class="text-[13px] text-white/80 block" data-ps="src/components/home/AboutOwner.astro:nlgljo">
                Owner · Grand Rapids, MI
              </span>
            </div>

            <a
              href="/contact/"
              class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center hover:bg-primary-hover transition-colors flex-shrink-0"
              aria-label="Contact JT"
             data-ps="src/components/home/AboutOwner.astro:ul2pf4">
              <svg class="w-4 h-4" stroke="currentColor" viewBox="0 0 24 24"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
