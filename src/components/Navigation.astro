---
import { SITE } from '@/config/site';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isServices = currentPath === '/services/' || currentPath.startsWith('/services');
const isPricing = currentPath === '/pricing/' || currentPath.startsWith('/pricing');
const isAbout = currentPath === '/about/' || currentPath.startsWith('/about');
const isReviews = currentPath === '/reviews/' || currentPath.startsWith('/reviews');
const isArea = currentPath === '/area/' || currentPath.startsWith('/area');
const isContact = currentPath === '/contact/' || currentPath.startsWith('/contact');
---

<header id="navbar" class="sticky top-0 z-50 bg-[hsl(45_33%_98%/0.95)] backdrop-blur-md border-b border-[hsl(45_12%_93%)]" data-ps="src/components/Navigation.astro:1zp37n">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between" data-ps="src/components/Navigation.astro:lxl1n0">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 no-underline group" data-ps="src/components/Navigation.astro:7vkjpt">
      <img
        src="https://pagesmith-cdn.com/381bbb8d/images/jt-logo-mark-320.webp"
        alt="JT's Heating Cooling & Plumbing logo"
        class="w-10 h-10 rounded-full object-cover flex-shrink-0"
        width="40"
        height="40" data-ps="src/components/Navigation.astro:jfbxbh" />
      <div class="flex flex-col" data-ps="src/components/Navigation.astro:lxl1n1">
        <span class="text-[15px] font-semibold text-foreground leading-tight tracking-tight group-hover:text-primary transition-colors" data-ps="src/components/Navigation.astro:7xpcai">
          JT's Heating Cooling & Plumbing
        </span>
        <span class="text-[10px] font-medium tracking-wider text-muted-foreground uppercase" data-ps="src/components/Navigation.astro:7xpcah">
          GRAND RAPIDS, MI
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1" data-ps="src/components/Navigation.astro:nrytym">
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:lxl1n2">
        <a href="/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isHome ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjpu">
          Home
        </a>
        {isHome && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:lxl1n3"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsd5">
        <a href="/services/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isServices ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjqg">
          Services
        </a>
        {isServices && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsd9"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsd6">
        <a href="/pricing/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isPricing ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjqh">
          Pricing
        </a>
        {isPricing && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsda"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsd7">
        <a href="/about/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isAbout ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjqi">
          About
        </a>
        {isAbout && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsdb"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsd8">
        <a href="/reviews/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isReviews ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjqj">
          Reviews
        </a>
        {isReviews && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsdc"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsd9">
        <a href="/area/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isArea ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjqk">
          Service Area
        </a>
        {isArea && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsdd"></div>}
      </div>
      <div class="relative px-3.5 py-2" data-ps="src/components/Navigation.astro:gqvsda">
        <a href="/contact/" class={`font-heading text-[14px] font-semibold tracking-[0.04em] ${isContact ? 'text-primary' : 'text-foreground/80 hover:text-primary'} no-underline transition-colors block`} data-ps="src/components/Navigation.astro:7vkjql">
          Contact
        </a>
        {isContact && <div class="w-5 h-[3px] bg-primary rounded-full mx-auto mt-1" data-ps="src/components/Navigation.astro:gqvsde"></div>}
      </div>
    </nav>

    <!-- Right Actions -->
    <div class="hidden sm:flex items-center gap-4" data-ps="src/components/Navigation.astro:gqvsdb">
      <a
        href={`tel:${SITE.phoneTel}`}
        class="text-[14px] font-medium text-foreground/80 hover:text-primary transition-colors flex items-center gap-2 no-underline"
       data-ps="src/components/Navigation.astro:7vkjqm">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.5 3.99c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.61c0-.55-.45-1-1-1z"/>
        </svg>
        <span class="font-bold text-primary" data-ps="src/components/Navigation.astro:7xpcag">{SITE.phone}</span>
      </a>

      <a
        href="/book/"
        class="bg-primary hover:bg-primary-hover text-primary-foreground text-[14px] font-semibold px-5 py-2.5 rounded-full flex items-center gap-1.5 shadow-sm transition-all no-underline"
       data-ps="src/components/Navigation.astro:7vkjqn">
        <span data-ps="src/components/Navigation.astro:7xpc9u">Book a Visit</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="lg:hidden p-2 text-foreground hover:text-primary transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
     data-ps="src/components/Navigation.astro:4mv7s">
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-background border-t border-border px-6 py-6"
    role="navigation"
    aria-label="Mobile navigation"
   data-ps="src/components/Navigation.astro:gqvsdc">
    <div class="flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsdd">
      <a href="/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isHome ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjqo">Home</a>
      <a href="/services/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isServices ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjqp">Services</a>
      <a href="/pricing/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isPricing ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjrb">Pricing</a>
      <a href="/about/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isAbout ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjrc">About</a>
      <a href="/reviews/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isReviews ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjrd">Reviews</a>
      <a href="/area/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isArea ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjre">Service Area</a>
      <a href="/contact/" class={`font-heading text-[15px] font-semibold tracking-[0.04em] py-2 no-underline ${isContact ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps="src/components/Navigation.astro:7vkjrf">Contact</a>

      <div class="pt-4 border-t border-border flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsde">
        <a
          href={`tel:${SITE.phoneTel}`}
          class="text-[15px] font-medium text-foreground flex items-center gap-2 no-underline"
         data-ps="src/components/Navigation.astro:7vkjrg">
          <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.5 3.99c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.61c0-.55-.45-1-1-1z"/>
          </svg>
          <span data-ps="src/components/Navigation.astro:7xpc9t">{SITE.phone}</span>
        </a>

        <a
          href="/book/"
          class="bg-primary hover:bg-primary-hover text-primary-foreground text-[15px] font-semibold px-5 py-3 rounded-full flex items-center justify-center gap-1.5 no-underline shadow-sm"
         data-ps="src/components/Navigation.astro:7vkjrh">
          <span data-ps="src/components/Navigation.astro:7xpc9s">Book a Visit</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
