---
const services = [
  "Furnace repair / no heat",
  "Furnace installation",
  "A/C service & repair",
  "Heat pump issue",
  "Mini-split installation",
  "Water heater replacement",
  "Plumbing issue",
  "Preventative maintenance",
  "Not sure yet"
];

const urgency = ["Flexible", "Anytime soon", "This week", "Within 5 days", "As soon as possible", "Today / tomorrow"];

const timeSlots = ["Morning 7–12", "Afternoon 12–5", "Evening 5–7"];

const propertyTypes = ["Single-family home", "Apartment / condo", "Townhouse", "Small business", "Rental property", "Other"];

const spaceTypes = ["Home", "Small business"];
---
<section id="booking-form" class="bg-[hsl(45_33%_98%)]" data-ps="src/components/book/BookForm.astro:iu4mp1">
  <div class="max-w-[1000px] mx-auto px-4 py-16" data-ps="src/components/book/BookForm.astro:h60lu4">
    <div id="book-status" class="hidden mb-6 px-4 py-3 rounded-2xl text-[15px]" data-ps="src/components/book/BookForm.astro:h60lti"></div>
    <form id="booking-form-el" action="https://formspree.io/f/mvkpzykb" method="POST" enctype="multipart/form-data" class="space-y-10">
      <input type="hidden" name="_subject" value="New booking request — JT's Heating Cooling & Plumbing" />

      <!-- Step 01 -->
      <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/book/BookForm.astro:h60lth">
        <div class="flex items-start justify-between mb-6" data-ps="src/components/book/BookForm.astro:h60ltg">
          <div data-ps="src/components/book/BookForm.astro:h60ltf">
            <span class="text-[14px] font-bold text-[hsl(210_100%_29%)]" data-ps="src/components/book/BookForm.astro:7q2rfc">01</span>
            <h2 class="text-[28px] font-semibold text-[hsl(240_4%_9%)] mt-1" data-ps="src/components/book/BookForm.astro:g57l6g">What do you need help with?</h2>
          </div>
        </div>
        <p class="text-[15px] text-[hsl(240_4%_36%)] mb-6" data-ps="src/components/book/BookForm.astro:mel02x">Tap one. Not sure? Pick the closest — you can add detail below.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" data-ps="src/components/book/BookForm.astro:h60lte">
          {services.map((svc, __psIdx) => (
            <label class="cursor-pointer bg-white border border-[hsl(45_12%_93%)] rounded-full px-5 py-3 text-[15px] font-medium text-[hsl(240_4%_9%)] flex items-center gap-2 hover:border-[hsl(210_100%_29%)] has-[:checked]:bg-[hsl(210_100%_29%)] has-[:checked]:text-white has-[:checked]:border-[hsl(210_100%_29%)] transition-all" data-ps={`src/components/book/BookForm.astro:2fyqlj-${__psIdx}`}>
              <input type="radio" name="service" value={svc} required={__psIdx === 0} class="sr-only" />
              <span class="text-[14px]" data-ps={`src/components/book/BookForm.astro:7q2rfb-${__psIdx}`}>{svc}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Step 02 -->
      <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/book/BookForm.astro:h60ltd">
        <span class="text-[14px] font-bold text-[hsl(210_100%_29%)]" data-ps="src/components/book/BookForm.astro:7q2rfa">02</span>
        <h2 class="text-[28px] font-semibold text-[hsl(240_4%_9%)] mt-1 mb-6" data-ps="src/components/book/BookForm.astro:g57l6f">When works for you?</h2>

        <div class="space-y-6" data-ps="src/components/book/BookForm.astro:h60ltc">
          <div data-ps="src/components/book/BookForm.astro:h60ltb">
            <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-3" data-ps="src/components/book/BookForm.astro:2fyqli">Urgency</label>
            <div class="flex flex-wrap gap-2" data-ps="src/components/book/BookForm.astro:h60lta">
              {urgency.map((u, __psIdx) => (
                <label class="cursor-pointer bg-white border border-[hsl(45_12%_93%)] rounded-full px-4 py-2 text-[14px] font-medium text-[hsl(240_4%_9%)] hover:border-[hsl(210_100%_29%)] has-[:checked]:bg-[hsl(210_100%_29%)] has-[:checked]:text-white has-[:checked]:border-[hsl(210_100%_29%)] transition-all" data-ps={`src/components/book/BookForm.astro:2fyqlh-${__psIdx}`}>
                  <input type="radio" name="urgency" value={u} required={__psIdx === 0} class="sr-only" />
                  {u}
                </label>
              ))}
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/components/book/BookForm.astro:h60lt9">
            <div data-ps="src/components/book/BookForm.astro:h60lsn">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqlg">Preferred date</label>
              <input type="date" name="date" class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] text-[hsl(240_4%_9%)] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
            </div>
            <div data-ps="src/components/book/BookForm.astro:h60lsm">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqlf">Preferred time</label>
              <div class="flex flex-wrap gap-2" data-ps="src/components/book/BookForm.astro:h60lsl">
                {timeSlots.map((t, __psIdx) => (
                  <label class="cursor-pointer bg-white border border-[hsl(45_12%_93%)] rounded-full px-4 py-2 text-[14px] font-medium text-[hsl(240_4%_9%)] hover:border-[hsl(210_100%_29%)] has-[:checked]:bg-[hsl(210_100%_29%)] has-[:checked]:text-white has-[:checked]:border-[hsl(210_100%_29%)] transition-all" data-ps={`src/components/book/BookForm.astro:2fyqkt-${__psIdx}`}>
                    <input type="radio" name="time" value={t} required={__psIdx === 0} class="sr-only" />
                    {t}
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/book/BookForm.astro:h60lsk">
        <div class="flex items-start justify-between mb-6" data-ps="src/components/book/BookForm.astro:h60lsj">
          <div data-ps="src/components/book/BookForm.astro:h60lsi">
            <span class="text-[14px] font-bold text-[hsl(210_100%_29%)]" data-ps="src/components/book/BookForm.astro:7q2rf9">03</span>
            <h2 class="text-[28px] font-semibold text-[hsl(240_4%_9%)] mt-1" data-ps="src/components/book/BookForm.astro:g57l6e">Where should I visit?</h2>
          </div>
          <span class="text-[12px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider" data-ps="src/components/book/BookForm.astro:7q2rf8">Almost done</span>
        </div>

        <div class="space-y-6" data-ps="src/components/book/BookForm.astro:h60lsh">
          <div data-ps="src/components/book/BookForm.astro:h60lsg">
            <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-3" data-ps="src/components/book/BookForm.astro:2fyqks">This is a</label>
            <div class="flex flex-wrap gap-2" data-ps="src/components/book/BookForm.astro:h60lsf">
              {spaceTypes.map((t, __psIdx) => (
                <label class="cursor-pointer bg-white border border-[hsl(45_12%_93%)] rounded-full px-5 py-2.5 text-[14px] font-medium text-[hsl(240_4%_9%)] hover:border-[hsl(210_100%_29%)] has-[:checked]:bg-[hsl(210_100%_29%)] has-[:checked]:text-white has-[:checked]:border-[hsl(210_100%_29%)] transition-all" data-ps={`src/components/book/BookForm.astro:2fyqkr-${__psIdx}`}>
                  <input type="radio" name="space" value={t} class="sr-only" />
                  {t}
                </label>
              ))}
            </div>
          </div>

          <div data-ps="src/components/book/BookForm.astro:h60lse">
            <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-3" data-ps="src/components/book/BookForm.astro:2fyqkq">Property type</label>
            <div class="flex flex-wrap gap-2" data-ps="src/components/book/BookForm.astro:hrypcm">
              {propertyTypes.map((t, __psIdx) => (
                <label class="cursor-pointer bg-white border border-[hsl(45_12%_93%)] rounded-full px-5 py-2.5 text-[14px] font-medium text-[hsl(240_4%_9%)] hover:border-[hsl(210_100%_29%)] has-[:checked]:bg-[hsl(210_100%_29%)] has-[:checked]:text-white has-[:checked]:border-[hsl(210_100%_29%)] transition-all" data-ps={`src/components/book/BookForm.astro:2fyqkp-${__psIdx}`}>
                  <input type="radio" name="property" value={t} class="sr-only" />
                  {t}
                </label>
              ))}
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-ps="src/components/book/BookForm.astro:hrypcn">
            <div data-ps="src/components/book/BookForm.astro:hrypco">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqko">Name</label>
              <input type="text" name="name" required class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
            </div>
            <div data-ps="src/components/book/BookForm.astro:hrypcp">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqkn">Phone</label>
              <input type="tel" name="phone" required class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
            </div>
            <div data-ps="src/components/book/BookForm.astro:hrypcq">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqkm">Email</label>
              <input type="email" name="email" required class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
            </div>
            <div data-ps="src/components/book/BookForm.astro:hrypcr">
              <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqkl">ZIP code</label>
              <input type="text" name="zip" class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
            </div>
          </div>

          <div data-ps="src/components/book/BookForm.astro:hrypcs">
            <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqkk">Address — optional</label>
            <input type="text" name="address" class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" />
          </div>

          <div data-ps="src/components/book/BookForm.astro:hrypct">
            <label class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqjy">Job description — optional but helpful</label>
            <textarea name="description" maxlength="500" class="w-full bg-white border border-[hsl(45_12%_93%)] rounded-2xl px-4 py-3 text-[15px] focus:border-[hsl(210_100%_29%)] focus:outline-none" rows="4"></textarea>
            <p class="text-[12px] text-[hsl(240_4%_36%)] mt-1" data-ps="src/components/book/BookForm.astro:mel02y">0 / 500</p>
          </div>

          <div data-ps="src/components/book/BookForm.astro:hrypcu">
            <label for="book-photos" class="block text-[14px] font-semibold text-[hsl(240_4%_9%)] mb-2" data-ps="src/components/book/BookForm.astro:2fyqjx">Add a photo — optional but helpful</label>
            <label class="block border-2 border-dashed border-[hsl(45_12%_93%)] rounded-2xl bg-white p-8 text-center cursor-pointer hover:border-[hsl(210_100%_29%)] transition-all" data-ps="src/components/book/BookForm.astro:2fyqjw">
              <input id="book-photos" type="file" name="photos" accept="image/*" multiple class="sr-only" />
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="hsl(240 4% 36%)" class="mx-auto"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              <p class="text-[15px] font-semibold text-[hsl(240_4%_9%)] mt-3" data-ps="src/components/book/BookForm.astro:mel02z">Tap to add a photo</p>
              <p class="text-[12px] text-[hsl(240_4%_36%)] mt-1" data-ps="src/components/book/BookForm.astro:mel030">JPG, PNG or HEIC · from camera or gallery · up to 3</p>
              <p id="book-photo-names" class="text-[12px] text-[hsl(240_4%_36%)] mt-1" data-ps="src/components/book/BookForm.astro:mel031"></p>
            </label>
          </div>

          <label class="flex items-start gap-3 cursor-pointer" data-ps="src/components/book/BookForm.astro:2fyqjv">
            <input type="checkbox" name="consent" required class="mt-1 w-5 h-5 rounded border-[hsl(45_12%_93%)] text-[hsl(210_100%_29%)] focus:ring-[hsl(210_100%_29%)]" />
            <span class="text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/book/BookForm.astro:7q2rf7">I'm happy for JT's Heating Cooling & Plumbing to contact me about this booking. My details won't be used for marketing.</span>
          </label>

          <div class="bg-white border border-[hsl(45_12%_93%)] rounded-2xl p-4 text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/book/BookForm.astro:hrypcv">
            JT will check the schedule and contact you to confirm the visit.
          </div>

          <button type="submit" id="book-submit" class="w-full bg-[hsl(210_100%_29%)] hover:bg-[hsl(210_100%_22%)] text-white rounded-full px-8 py-4 text-[18px] font-semibold flex items-center justify-center gap-2" data-ps="src/components/book/BookForm.astro:9zh0l5">
            Book My Visit
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M16.003 9.414l-7.56 7.56-1.414-1.414L13.172 9.414H4v-2h14.172l-6.144-6.144 1.414-1.414 8.558 8.558z"/></svg>
          </button>
        </div>
      </div>

    </form>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form-el') as HTMLFormElement | null;
  const status = document.getElementById('book-status') as HTMLDivElement | null;
  const submitBtn = document.getElementById('book-submit') as HTMLButtonElement | null;
  const photos = document.getElementById('book-photos') as HTMLInputElement | null;
  const photoNames = document.getElementById('book-photo-names');

  photos?.addEventListener('change', () => {
    const files = Array.from(photos.files ?? []).slice(0, 3);
    if (photoNames) photoNames.textContent = files.map((f) => f.name).join(', ');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;
    submitBtn.disabled = true;
    const original = submitBtn.innerHTML;
    submitBtn.textContent = 'Sending...';

    const data = new FormData(form);
    const files = Array.from((photos?.files ?? []) as File[]).slice(0, 3);
    data.delete('photos');
    files.forEach((file, i) => data.append(`photo_${i + 1}`, file));

    try {
      const response = await fetch('https://formspree.io/f/mvkpzykb', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        status.className = 'mb-6 px-4 py-3 rounded-2xl text-[15px] bg-green-50 border border-green-200 text-green-800';
        status.textContent = 'Thanks — your visit request is in. JT will contact you to confirm.';
        form.reset();
        if (photoNames) photoNames.textContent = '';
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        throw new Error('Failed to send');
      }
    } catch {
      status.className = 'mb-6 px-4 py-3 rounded-2xl text-[15px] bg-red-50 border border-red-200 text-red-800';
      status.textContent = 'Something went wrong. Please call (616) 840-3105 or try again.';
      status.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = original;
    }
  });
</script>
