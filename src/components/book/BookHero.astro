---
---
<section class="w-full relative overflow-hidden bg-[hsl(240_50%_11%)]" data-ps="src/components/book/BookHero.astro:g4iyu">
  <div class="relative min-h-[460px] md:min-h-[500px] flex items-center w-full" data-ps="src/components/book/BookHero.astro:b280nx">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/472567725084a270d9b6a92f01ad92da-1536-1536.webp"
      alt="Book a Visit with JT's Heating Cooling & Plumbing"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/book/BookHero.astro:u3n2nx" />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/book/BookHero.astro:b280nw"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 w-full z-10 relative" data-ps="src/components/book/BookHero.astro:b280nv">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full" data-ps="src/components/book/BookHero.astro:b280nu">
        <div class="lg:col-span-8 flex flex-col items-start text-left" data-ps="src/components/book/BookHero.astro:b280nt">
          <span class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6 backdrop-blur-sm" data-ps="src/components/book/BookHero.astro:h9yvph">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/book/BookHero.astro:h9yvpg"></span>
            Book Online
          </span>
          <h1 class="text-[36px] sm:text-[46px] md:text-[50px] font-semibold leading-[1.28] sm:leading-[1.3] tracking-[-1.2px] text-white m-0 mb-4" data-ps="src/components/book/BookHero.astro:nkp7u0">
            Book a visit from your <span class="inline-block bg-white text-primary px-2.5 py-0 rounded-lg italic font-semibold" data-ps="src/components/book/BookHero.astro:h9yvpf">local HVAC tech.</span>
          </h1>
          <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.625] max-w-[580px] mb-8 font-normal" data-ps="src/components/book/BookHero.astro:j1cmmy">
            Takes about a minute. Add a photo of your unit if you can — it helps me come prepared with the right parts.
          </p>
          <div class="flex flex-wrap items-center gap-4" data-ps="src/components/book/BookHero.astro:b280ns">
            <a href="#booking-form" class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline" data-ps="src/components/book/BookHero.astro:bxepxb">
              <span data-ps="src/components/book/BookHero.astro:h9yvpe">Start Booking</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a href="/pricing/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm" data-ps="src/components/book/BookHero.astro:bxepxa">
              Request a quote
            </a>
          </div>
          <div class="flex items-center gap-2 mt-6 text-white/90 text-[14px]" data-ps="src/components/book/BookHero.astro:b280nr">
            <span class="text-amber-300 text-[14px]" data-ps="src/components/book/BookHero.astro:h9yvpd">★</span>
            5.0 · 27 Google reviews
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
