---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const shuffled = [...allReviews].sort(() => Math.random() - 0.5);
const slides = shuffled.slice(0, 6).map((entry) => ({
  author: entry.data.author,
  rating: entry.data.rating,
  body: entry.data.body,
}));
const reviewCount = allReviews.length;
const avg =
  reviewCount === 0
    ? 5
    : Math.round(
        (allReviews.reduce((sum, r) => sum + r.data.rating, 0) / reviewCount) * 10,
      ) / 10;
---

{
  slides.length > 0 && (
    <div
      class="bg-white/10 backdrop-blur-md border border-white/20 rounded-[24px] p-6 sm:p-7 text-white max-w-[420px] shadow-2xl relative w-full"
      data-hero-review-slider
      data-ps="src/components/HeroReviewSlider.astro:card1"
    >
      <div class="flex items-center gap-2 text-[12px] font-semibold text-white/90 tracking-wider uppercase mb-3" data-ps="src/components/HeroReviewSlider.astro:rating">
        <span class="text-amber-400 text-[14px]" data-ps="src/components/HeroReviewSlider.astro:yh4vdj">★</span>
        <span data-ps="src/components/HeroReviewSlider.astro:yh4vdi">5.0 · 31 GOOGLE REVIEWS</span>
      </div>
      <div class="flex items-center gap-1 text-amber-400 text-[15px] mb-4" data-hero-stars data-ps="src/components/HeroReviewSlider.astro:stars">
        {Array.from({ length: Math.round(slides[0].rating) }).map(() => <span data-ps="src/components/HeroReviewSlider.astro:yh4vdh">★</span>)}
      </div>
      <blockquote class="text-[14px] sm:text-[15px] text-white/95 leading-[1.6] m-0 mb-4 font-normal line-clamp-5 min-h-[7.5em]" data-hero-quote data-ps="src/components/HeroReviewSlider.astro:quote">
        “{slides[0].body}”
      </blockquote>
      <div class="text-[13px] text-white/70 font-medium mb-5" data-hero-author data-ps="src/components/HeroReviewSlider.astro:author">
        — {slides[0].author}, verified Google review
      </div>
      <div class="flex items-center gap-2" data-hero-dots data-ps="src/components/HeroReviewSlider.astro:dots">
        {slides.map((_, i) => (
          <button
            type="button"
            class:list={[
              'rounded-full border-0 p-0 cursor-pointer',
              i === 0 ? 'w-6 h-1.5 bg-white' : 'w-1.5 h-1.5 bg-white/40',
            ]}
            aria-label={`Show review ${i + 1}`}
            data-dot-index={i}
          />
        ))}
      </div>
    </div>
  )
}

<script define:vars={{ slides }}>
  document.querySelectorAll('[data-hero-review-slider]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    let i = 0;
    const quote = root.querySelector('[data-hero-quote]');
    const author = root.querySelector('[data-hero-author]');
    const stars = root.querySelector('[data-hero-stars]');
    const dots = root.querySelectorAll('[data-dot-index]');
    function render() {
      const s = slides[i];
      if (!s) return;
      if (quote) quote.textContent = '"' + s.body + '"';
      if (author) author.textContent = '— ' + s.author + ', verified Google review';
      if (stars) stars.textContent = '★'.repeat(Math.round(s.rating));
      dots.forEach((dot, idx) => {
        dot.className =
          idx === i
            ? 'rounded-full border-0 p-0 cursor-pointer w-6 h-1.5 bg-white'
            : 'rounded-full border-0 p-0 cursor-pointer w-1.5 h-1.5 bg-white/40';
      });
    }
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        i = Number(dot.getAttribute('data-dot-index')) || 0;
        render();
      });
    });
    if (slides.length > 1) {
      setInterval(() => {
        i = (i + 1) % slides.length;
        render();
      }, 6000);
    }
  });
</script>
