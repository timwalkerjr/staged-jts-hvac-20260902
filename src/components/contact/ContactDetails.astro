---
const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d373698.70357126556!2d-85.374213!3d42.967295050000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x45868e3d711e8545%3A0xbd11d7f5d3ec1f7c!2sJT's%20Heating%20Cooling%20%26%20Plumbing!5e0!3m2!1sen!2sus!4v1788368765239!5m2!1sen!2sus";
---
<section class="bg-[hsl(45_33%_98%)]" data-ps="src/components/contact/ContactDetails.astro:guxer9">
  <div class="max-w-[1400px] mx-auto px-4 py-24" data-ps="src/components/contact/ContactDetails.astro:i8rfj6">
    <div class="text-center mb-12" data-ps="src/components/contact/ContactDetails.astro:i8rfj5">
      <span class="inline-flex items-center gap-2 bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-full px-3 py-1 text-[11px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider mb-4" data-ps="src/components/contact/ContactDetails.astro:klhpcv">
        Direct contact
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16" data-ps="src/components/contact/ContactDetails.astro:i8rfj4">
      <a href="tel:+16168403105" class="bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-8 hover:border-[hsl(210_100%_29%)] transition-all group" data-ps="src/components/contact/ContactDetails.astro:p5790a">
        <span class="text-[12px] font-semibold uppercase tracking-wider text-[hsl(240_4%_36%)]" data-ps="src/components/contact/ContactDetails.astro:klhpcu">Call</span>
        <p class="text-[28px] md:text-[32px] font-semibold text-[hsl(240_4%_9%)] mt-2" data-ps="src/components/contact/ContactDetails.astro:w955p8">(616) 840-3105</p>
        <p class="text-[14px] text-[hsl(240_4%_36%)] mt-3" data-ps="src/components/contact/ContactDetails.astro:w955p7">Speak directly to JT — no call centre.</p>
      </a>
      <a href="/book/" class="bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-8 hover:border-[hsl(210_100%_29%)] transition-all group" data-ps="src/components/contact/ContactDetails.astro:p57909">
        <span class="text-[12px] font-semibold uppercase tracking-wider text-[hsl(240_4%_36%)]" data-ps="src/components/contact/ContactDetails.astro:klhpct">Online</span>
        <p class="text-[28px] md:text-[32px] font-semibold text-[hsl(240_4%_9%)] mt-2" data-ps="src/components/contact/ContactDetails.astro:w955p6">Request a Visit</p>
        <p class="text-[14px] text-[hsl(240_4%_36%)] mt-3" data-ps="src/components/contact/ContactDetails.astro:w955p5">Send the details and JT will call to confirm.</p>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12" data-ps="src/components/contact/ContactDetails.astro:i8rfj3">
      <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/contact/ContactDetails.astro:i8rfj2">
        <h3 class="text-[24px] font-semibold text-[hsl(240_4%_9%)] mb-6" data-ps="src/components/contact/ContactDetails.astro:4ocf1f">Working hours</h3>
        <ul class="space-y-4">
          <li class="flex items-start justify-between gap-4 pb-4 border-b border-[hsl(45_12%_93%)]" data-ps="src/components/contact/ContactDetails.astro:k3q8qk">
            <span class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/contact/ContactDetails.astro:klhpcs">Mon–Fri</span>
            <span class="text-[16px] text-[hsl(240_4%_36%)]" data-ps="src/components/contact/ContactDetails.astro:klhpcr">7:00 AM – 7:00 PM</span>
          </li>
          <li class="flex items-start justify-between gap-4" data-ps="src/components/contact/ContactDetails.astro:k3q8ql">
            <span class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/contact/ContactDetails.astro:klhpc5">Emergency calls</span>
            <span class="text-[16px] text-[hsl(240_4%_36%)]" data-ps="src/components/contact/ContactDetails.astro:klhpc4">When schedule allows</span>
          </li>
        </ul>
      </div>

      <div class="bg-[hsl(240_50%_11%)] text-white rounded-[32px] p-8" data-ps="src/components/contact/ContactDetails.astro:i8rfj1">
        <h3 class="text-[24px] font-semibold mb-4" data-ps="src/components/contact/ContactDetails.astro:4ocf1g">Emergency?</h3>
        <p class="text-[16px] text-white/80 leading-[1.625]" data-ps="src/components/contact/ContactDetails.astro:w955p4">
          For gas leaks or immediate safety hazards, call 911 and your utility company first. Then call me.
        </p>
        <a href="tel:+16168403105" class="mt-6 inline-flex items-center text-[24px] font-semibold text-white hover:text-[hsl(210_100%_29%)]" data-ps="src/components/contact/ContactDetails.astro:p57908">
          (616) 840-3105
        </a>
      </div>
    </div>

    <div class="mt-16" data-ps="src/components/contact/ContactDetails.astro:i8rfj0">
      <h3 class="text-[28px] md:text-[36px] font-semibold mb-8 text-center" data-ps="src/components/contact/ContactDetails.astro:vxe7do">
        Find us in <span class="italic text-[hsl(210_100%_29%)]" data-ps="src/components/contact/ContactDetails.astro:klhpc3">Grand Rapids.</span>
      </h3>
      <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden aspect-[16/9] min-h-[450px] relative" data-ps="src/components/contact/ContactDetails.astro:i8rfiz">
        <iframe
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          class="w-full h-full min-h-[450px] border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="JT's Heating Cooling & Plumbing Google Map"
        ></iframe>
      </div>
    </div>
  </div>
</section>
