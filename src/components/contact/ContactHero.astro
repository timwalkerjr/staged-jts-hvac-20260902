---
<section class="w-full relative overflow-hidden bg-[hsl(240_50%_11%)]" data-ps="src/components/contact/ContactHero.astro:kj12ag">
  <div class="relative min-h-[460px] md:min-h-[500px] flex items-center w-full" data-ps="src/components/contact/ContactHero.astro:a0s9s1">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/af8a0a4959a737a8464350c7e59ad8e2-1536-1536.webp"
      alt="Contact JT's Heating Cooling & Plumbing"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/contact/ContactHero.astro:jugov9" />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/contact/ContactHero.astro:a0s9s2"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 w-full z-10 relative" data-ps="src/components/contact/ContactHero.astro:a0s9s3">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full" data-ps="src/components/contact/ContactHero.astro:a0s9s4">
        <div class="lg:col-span-8 flex flex-col items-start text-left" data-ps="src/components/contact/ContactHero.astro:a0s9s5">
          <span class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6 backdrop-blur-sm" data-ps="src/components/contact/ContactHero.astro:rp5r31">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/contact/ContactHero.astro:rp5r32"></span>
            Contact JT
          </span>
          <h1 class="text-[36px] sm:text-[46px] md:text-[50px] font-semibold leading-[1.28] sm:leading-[1.3] tracking-[-1.2px] text-white m-0 mb-4" data-ps="src/components/contact/ContactHero.astro:c51wee">
            Get in touch, <span class="inline-block bg-white text-primary px-2.5 py-0 rounded-lg italic font-semibold" data-ps="src/components/contact/ContactHero.astro:rp5r33">it's easy.</span>
          </h1>
          <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.625] max-w-[580px] mb-8 font-normal" data-ps="src/components/contact/ContactHero.astro:12q9q0">
            Need heating, cooling or plumbing help? Send a message or call — I'll get back to you as soon as possible.
          </p>
          <div class="flex flex-wrap items-center gap-4" data-ps="src/components/contact/ContactHero.astro:a0s9s6">
            <a href="#contact-form" class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline" data-ps="src/components/contact/ContactHero.astro:617mzn">
              <span data-ps="src/components/contact/ContactHero.astro:rp5r34">Send a Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a href="/book/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm" data-ps="src/components/contact/ContactHero.astro:617mzo">
              Book a Visit
            </a>
          </div>
          <div class="flex items-center gap-2 mt-6 text-white/90 text-[14px]" data-ps="src/components/contact/ContactHero.astro:a0s9s7">
            <span class="text-amber-300 text-[14px]" data-ps="src/components/contact/ContactHero.astro:rp5r35">★</span>
            5.0 · 27 Google reviews
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
