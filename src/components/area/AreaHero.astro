---
---
<section class="w-full relative overflow-hidden bg-[hsl(240_50%_11%)]" data-ps="src/components/area/AreaHero.astro:2v84my">
  <div class="relative min-h-[500px] md:min-h-[560px] flex items-center w-full" data-ps="src/components/area/AreaHero.astro:pbpulf">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/54571514064882283839167162bd38f0-1536-1536.webp"
      alt="Service Area across Grand Rapids and West Michigan"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/area/AreaHero.astro:4jj41v" />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/area/AreaHero.astro:pbpulg"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 w-full z-10 relative" data-ps="src/components/area/AreaHero.astro:pbpulh">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full" data-ps="src/components/area/AreaHero.astro:pbpuli">
        <div class="lg:col-span-8 flex flex-col items-start text-left" data-ps="src/components/area/AreaHero.astro:pbpulj">
          <span class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6 backdrop-blur-sm" data-ps="src/components/area/AreaHero.astro:7jxcat">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/area/AreaHero.astro:7jxcas"></span>
            Service Area
          </span>
          <h1 class="text-[36px] sm:text-[46px] md:text-[50px] font-semibold leading-[1.28] sm:leading-[1.3] tracking-[-1.2px] text-white m-0 mb-4" data-ps="src/components/area/AreaHero.astro:3wga0">
            Serving <span class="inline-block bg-white text-primary px-2.5 py-0 rounded-lg italic font-semibold" data-ps="src/components/area/AreaHero.astro:7jxcar">Grand Rapids</span> & West Michigan.
          </h1>
          <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.625] max-w-[580px] mb-8 font-normal" data-ps="src/components/area/AreaHero.astro:1gpa8q">
            Based in Grand Rapids and serving the surrounding West Michigan communities — from Kentwood and Wyoming up to Rockford and out to Lowell.
          </p>
          <div class="flex flex-wrap items-center gap-4" data-ps="src/components/area/AreaHero.astro:pbpulk">
            <a href="/book/" class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline" data-ps="src/components/area/AreaHero.astro:5n8mgx">
              <span data-ps="src/components/area/AreaHero.astro:7jxcaq">Check My Area</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
            <a href="/services/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm" data-ps="src/components/area/AreaHero.astro:5n8mgy">
              See services
            </a>
          </div>
          <div class="flex items-center gap-2 mt-6 text-white/90 text-[14px]" data-ps="src/components/area/AreaHero.astro:pbpull">
            <span class="text-amber-300 text-[14px]" data-ps="src/components/area/AreaHero.astro:7jxcap">★</span>
            5.0 · 27 Google reviews
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
