---
const cities = [
  { name: "Grand Rapids", zip: "49503 · 49505", desc: "Home base — call for current availability.", img: "https://pagesmith-cdn.com/381bbb8d/images/1430bc1d1a6368af376e246c66a87060-1536-1536.webp" },
  { name: "Kentwood", zip: "49508 · 49512", desc: "Family neighborhoods and suburban homes.", img: "https://pagesmith-cdn.com/381bbb8d/images/1b40c8d9493c040849576be631d10da0-1536-1536.webp" },
  { name: "Wyoming", zip: "49509 · 49519", desc: "Heating, cooling, and water heater help.", img: "https://pagesmith-cdn.com/381bbb8d/images/8f9ee504c8755e8d94ca6fb1ead68ad9-1536-1536.webp" },
  { name: "Rockford & North", zip: "49341 · 49321", desc: "Homes, cabins and lakeside properties up north.", img: "https://pagesmith-cdn.com/381bbb8d/images/86bc8bb2bf53e3942070afba8978acb0-1536-1536.webp" }
];

const allCities = [
  "Grand Rapids", "Saranac", "Lowell", "Kentwood", "Wyoming", "Ada",
  "Walker", "Rockford", "Greenville", "Portland", "Hudsonville", "West Michigan"
];
---
<section class="bg-[hsl(45_18%_96%)]">
  <div class="max-w-[1400px] mx-auto px-4 py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {cities.map((city) => (
        <div class="bg-[hsl(45_33%_98%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden p-3 hover:shadow-lg transition-all">
          <img src={city.img} alt={city.name} class="h-[200px] rounded-[24px] object-cover w-full" />
          <div class="p-4">
            <h3 class="text-[22px] font-semibold text-[hsl(240_4%_9%)] mt-2">{city.name}</h3>
            <p class="text-[12px] font-semibold text-[hsl(240_4%_36%)] mt-1">{city.zip}</p>
            <p class="text-[14px] text-[hsl(240_4%_36%)] mt-2">{city.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div>
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] rounded-full px-3 py-1 text-[11px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider mb-4">
          Cities we serve
        </span>
        <h2 class="text-[36px] md:text-[48px] font-semibold tracking-tight">
          Communities we know <span class="italic text-[hsl(210_100%_29%)]">very well.</span>
        </h2>
        <p class="text-[18px] text-[hsl(240_4%_36%)] max-w-[700px] mx-auto mt-4">
          Not sure if you're in the service area? Send me your address — most of the communities below and everything nearby are covered.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        {allCities.map((city) => (
          <span class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] rounded-full px-5 py-2.5 text-[16px] font-semibold text-[hsl(240_4%_9%)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="hsl(210 100% 29%)"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            {city}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
