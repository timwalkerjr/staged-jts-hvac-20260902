---
const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d373698.70357126556!2d-85.374213!3d42.967295050000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x45868e3d711e8545%3A0xbd11d7f5d3ec1f7c!2sJT's%20Heating%20Cooling%20%26%20Plumbing!5e0!3m2!1sen!2sus!4v1788368765239!5m2!1sen!2sus";
---
<section class="bg-[hsl(45_33%_98%)]" data-ps="src/components/area/AreaMap.astro:yuqa9y">
  <div class="max-w-[1400px] mx-auto px-4 py-24" data-ps="src/components/area/AreaMap.astro:vbumzh">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12" data-ps="src/components/area/AreaMap.astro:vbumzg">
      <div data-ps="src/components/area/AreaMap.astro:vbumzf">
        <span class="inline-flex items-center gap-2 bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-full px-3 py-1 text-[11px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider mb-4" data-ps="src/components/area/AreaMap.astro:squbui">
          <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)]" data-ps="src/components/area/AreaMap.astro:squbuj"></span>
          Where we work
        </span>
        <h2 class="text-[36px] md:text-[48px] font-semibold tracking-tight max-w-[700px]" data-ps="src/components/area/AreaMap.astro:pwrg7">
          One local zone, <span class="italic text-[hsl(210_100%_29%)]" data-ps="src/components/area/AreaMap.astro:squbuk">done properly.</span>
        </h2>
        <p class="text-[18px] text-[hsl(240_4%_36%)] max-w-[640px] mt-4" data-ps="src/components/area/AreaMap.astro:odzlzu">
          I work across West Michigan so I can get to jobs quickly and know the area well. If you're outside the zone, send me a message and I'll let you know if I can help.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-ps="src/components/area/AreaMap.astro:vbumze">
      <div class="lg:col-span-7 bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[32px] overflow-hidden aspect-[4/3] min-h-[450px] relative" data-ps="src/components/area/AreaMap.astro:vbumzd">
        <iframe
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          class="w-full h-full min-h-[450px] border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="JT's Heating Cooling & Plumbing Google Map"
        ></iframe>
      </div>

      <div class="lg:col-span-5 space-y-6" data-ps="src/components/area/AreaMap.astro:vbumzc">
        <div class="bg-[hsl(45_18%_96%)] border border-[hsl(45_12%_93%)] rounded-[24px] p-8" data-ps="src/components/area/AreaMap.astro:vbumzb">
          <h3 class="text-[20px] font-semibold text-[hsl(240_4%_9%)] mb-4" data-ps="src/components/area/AreaMap.astro:16yel4">Quick facts</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-[16px] text-[hsl(240_4%_9%)]" data-ps="src/components/area/AreaMap.astro:lk8qax">
              <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)] mt-2 shrink-0" data-ps="src/components/area/AreaMap.astro:squbul"></span>
              Home base: Grand Rapids
            </li>
            <li class="flex items-start gap-3 text-[16px] text-[hsl(240_4%_9%)]" data-ps="src/components/area/AreaMap.astro:lk8qaw">
              <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)] mt-2 shrink-0" data-ps="src/components/area/AreaMap.astro:squbum"></span>
              Call for current availability
            </li>
            <li class="flex items-start gap-3 text-[16px] text-[hsl(240_4%_9%)]" data-ps="src/components/area/AreaMap.astro:lk8qav">
              <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)] mt-2 shrink-0" data-ps="src/components/area/AreaMap.astro:squbun"></span>
              Grand Rapids and surrounding areas
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
