---
---
<section class="bg-[hsl(45_33%_98%)]">
  <div class="max-w-[1400px] mx-auto px-4 pb-24">
    <div class="bg-[hsl(211_100%_95%)] rounded-[32px] p-10 md:p-16 flex flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 bg-white border border-[hsl(45_12%_93%)] rounded-full px-4 py-1.5 text-[11px] font-semibold text-[hsl(240_4%_36%)] uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[hsl(210_100%_29%)]"></span>
        Book online
      </span>
      <h2 class="text-[36px] md:text-[48px] font-semibold tracking-tight max-w-[800px]">
        Get a clear quote, <span class="italic text-[hsl(210_100%_29%)] block">without the hassle.</span>
      </h2>
      <p class="text-[18px] text-[hsl(240_4%_36%)] max-w-[600px] mt-4 mb-8">
        A quick booking form and a description of what's going on is all I need to get you a price.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
        <a href="/book/" class="bg-[hsl(240_50%_11%)] hover:bg-[hsl(240_48%_6%)] text-white rounded-full px-8 py-4 text-[16px] font-semibold flex items-center gap-2">
          Book a Visit
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16.003 9.414l-7.56 7.56-1.414-1.414L13.172 9.414H4v-2h14.172l-6.144-6.144 1.414-1.414 8.558 8.558z"/></svg>
        </a>
        <a href="/contact/" class="border border-[hsl(45_12%_93%)] bg-transparent text-[hsl(240_4%_9%)] rounded-full px-8 py-4 text-[16px] font-semibold hover:border-[hsl(210_100%_29%)] flex items-center gap-2">
          Send a message
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16.003 9.414l-7.56 7.56-1.414-1.414L13.172 9.414H4v-2h14.172l-6.144-6.144 1.414-1.414 8.558 8.558z"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-[700px]">
        <a href="tel:+16168403105" class="bg-white border border-[hsl(45_12%_93%)] rounded-[24px] p-6 flex flex-col items-start hover:border-[hsl(210_100%_29%)] transition-all">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[hsl(240_4%_36%)]">Call</span>
          <span class="text-[20px] font-semibold text-[hsl(240_4%_9%)] mt-1">(616) 840-3105</span>
        </a>
        <a href="/book/" class="bg-white border border-[hsl(45_12%_93%)] rounded-[24px] p-6 flex flex-col items-start hover:border-[hsl(210_100%_29%)] transition-all">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[hsl(240_4%_36%)]">Online</span>
          <span class="text-[20px] font-semibold text-[hsl(240_4%_9%)] mt-1">Book a Visit</span>
        </a>
      </div>
    </div>
  </div>
</section>
