---
const reviews = [
  { quote: "Jordan was fantastic. He came out quickly, explained everything along the way, and we had A/C again during the heat wave! Use JT's!!!!!", author: "Jim", meta: "Verified Google review" },
  { quote: "Jordan was very knowledgeable and professional. He was able to give us some energy saving tips. I highly recommend him!", author: "Charissa Hunter", meta: "Verified Google review" },
  { quote: "Had Jordan out for a quote and he was great! Very kind and helpful, got to the house quickly and communicated well! From my interaction so far, it's been great!", author: "Lacey T", meta: "Verified Google review" },
  { quote: "JT diagnosed our AC issue in just minutes. He has the diagnostic tools and even shows you the report. A stand up, honest guy. Call JT.", author: "Ian Barrie", meta: "Verified Google review" }
];
---
<section class="bg-[hsl(45_18%_96%)]" data-ps="src/components/pricing/PricingReviews.astro:l1mvcy">
  <div class="max-w-[1400px] mx-auto px-4 py-20 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center" data-ps="src/components/pricing/PricingReviews.astro:xfjnyv">
    <div class="lg:col-span-7" data-ps="src/components/pricing/PricingReviews.astro:xfjnyw">
      <div class="inline-flex items-center gap-1.5 bg-white border border-[hsl(45_12%_93%)] rounded-full px-4 py-1.5 text-[12px] font-semibold mb-6" data-ps="src/components/pricing/PricingReviews.astro:xfjnyx">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="oklch(0.828 0.189 84.429)"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        5.0 · 31 Google reviews
      </div>
      <div class="space-y-5" data-ps="src/components/pricing/PricingReviews.astro:lu1u29">
        {reviews.slice(0, 2).map((review, __psIdx) => (
          <blockquote class="border-l-4 border-[hsl(210_100%_29%)] pl-6 py-2">
            <p class="text-[18px] font-medium leading-[1.4] text-[hsl(240_4%_9%)] mb-2" data-ps={`src/components/pricing/PricingReviews.astro:rmiimm-${__psIdx}`}>"{review.quote}"</p>
            <footer class="flex items-center gap-2" data-ps={`src/components/pricing/PricingReviews.astro:o2lc5p-${__psIdx}`}>
              <span class="text-[15px] font-semibold text-[hsl(240_4%_9%)]" data-ps={`src/components/pricing/PricingReviews.astro:wr07f5-${__psIdx}`}>— {review.author}</span>
              <span class="text-[13px] text-[hsl(240_4%_36%)]" data-ps={`src/components/pricing/PricingReviews.astro:wr07f6-${__psIdx}`}>· {review.meta}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
    <div class="lg:col-span-5" data-ps="src/components/pricing/PricingReviews.astro:lu1u28">
      <div class="bg-white border border-[hsl(45_12%_93%)] rounded-[32px] p-8" data-ps="src/components/pricing/PricingReviews.astro:lu1u27">
        <div class="space-y-6" data-ps="src/components/pricing/PricingReviews.astro:lu1u26">
          <div class="flex items-center gap-3 pb-6 border-b border-[hsl(45_12%_93%)]" data-ps="src/components/pricing/PricingReviews.astro:lu1u25">
            <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-[hsl(210_100%_29%)] flex items-center justify-center" data-ps="src/components/pricing/PricingReviews.astro:lu1u24">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
            </div>
            <div data-ps="src/components/pricing/PricingReviews.astro:lu1u23">
              <p class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/pricing/PricingReviews.astro:rmiimn">Licensed & insured</p>
              <p class="text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/pricing/PricingReviews.astro:rmiimo">Call for availability</p>
            </div>
          </div>
          <div class="flex items-center gap-3" data-ps="src/components/pricing/PricingReviews.astro:lu1u22">
            <div class="w-10 h-10 rounded-full bg-[hsl(210_100%_29%/0.1)] text-[hsl(210_100%_29%)] flex items-center justify-center" data-ps="src/components/pricing/PricingReviews.astro:lu1u21">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </div>
            <div data-ps="src/components/pricing/PricingReviews.astro:lu1u20">
              <p class="text-[16px] font-semibold text-[hsl(240_4%_9%)]" data-ps="src/components/pricing/PricingReviews.astro:rmiimp">5.0 · 31 reviews</p>
              <p class="text-[14px] text-[hsl(240_4%_36%)]" data-ps="src/components/pricing/PricingReviews.astro:rmiimq">Local & owner-operated</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
