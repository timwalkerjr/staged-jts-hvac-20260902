---
import HeroReviewSlider from '@/components/HeroReviewSlider.astro';
---
<section class="w-full relative overflow-hidden bg-[hsl(240_50%_11%)]" data-ps="src/components/pricing/PricingHero.astro:s1h4l0">
  <div class="relative min-h-[460px] md:min-h-[500px] flex items-center w-full" data-ps="src/components/pricing/PricingHero.astro:35mo8l">
    <!-- Background Image -->
    <img
      src="https://pagesmith-cdn.com/381bbb8d/images/932628f9e6465748012a274684b6f91e-1536-1536.webp"
      alt="Clear HVAC and Plumbing Quotes in Grand Rapids"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" data-ps="src/components/pricing/PricingHero.astro:qpmaep" />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to right, rgba(14, 14, 42, 0.94) 0%, rgba(14, 14, 42, 0.75) 55%, rgba(14, 14, 42, 0.35) 100%);"
     data-ps="src/components/pricing/PricingHero.astro:35mo8m"></div>

    <!-- Main Content Container -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 w-full z-10 relative" data-ps="src/components/pricing/PricingHero.astro:35mo8n">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center w-full" data-ps="src/components/pricing/PricingHero.astro:35mo8o">
        <div class="lg:col-span-7 flex flex-col items-start text-left" data-ps="src/components/pricing/PricingHero.astro:35mo8p">
          <span class="bg-white/10 border border-white/25 text-white text-[12px] font-medium px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6 backdrop-blur-sm" data-ps="src/components/pricing/PricingHero.astro:2dcbtj">
            <span class="w-2 h-2 rounded-full bg-emerald-400" data-ps="src/components/pricing/PricingHero.astro:2dcbti"></span>
            Clear Quotes
          </span>
          <h1 class="text-[36px] sm:text-[46px] md:text-[50px] font-semibold leading-[1.28] sm:leading-[1.3] tracking-[-1.2px] text-white m-0 mb-4" data-ps="src/components/pricing/PricingHero.astro:jndw5i">
            Call for a quote, <span class="inline-block bg-white text-primary px-2.5 py-0 rounded-lg italic font-semibold" data-ps="src/components/pricing/PricingHero.astro:2dcbth">no surprises.</span>
          </h1>
          <p class="text-[17px] sm:text-[18px] text-white/90 leading-[1.625] max-w-[580px] mb-8 font-normal" data-ps="src/components/pricing/PricingHero.astro:rooutw">
            Tell JT what is going on and get clear options for local work in Grand Rapids and West Michigan before any work starts.
          </p>
          <div class="flex flex-wrap items-center gap-4" data-ps="src/components/pricing/PricingHero.astro:35mo8q">
            <a href="/book/" class="bg-primary hover:bg-primary-hover text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold flex items-center gap-2 shadow-lg transition-all no-underline" data-ps="src/components/pricing/PricingHero.astro:ysmrjj">
              <span data-ps="src/components/pricing/PricingHero.astro:2dcbtg">Check Availability</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
            <a href="/services/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white rounded-full px-7 py-3.5 text-[15px] sm:text-[16px] font-semibold transition-colors no-underline backdrop-blur-sm" data-ps="src/components/pricing/PricingHero.astro:ysmrjk">
              View services
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center lg:justify-end w-full" data-ps="src/components/pricing/PricingHero.astro:cardcol">
          <HeroReviewSlider />
        </div>
      </div>
    </div>
  </div>
</section>
