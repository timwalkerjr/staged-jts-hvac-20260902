---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title={`Licensed & Insured | ${SITE.name}`}
  description="JT's Heating Cooling & Plumbing is a licensed and insured, owner-operated HVAC and plumbing company in Grand Rapids, Michigan."
>
  <section class="bg-[hsl(45_33%_98%)]">
    <div class="max-w-[800px] mx-auto px-4 py-20 sm:py-24">
      <p class="text-[12px] font-semibold uppercase tracking-wider text-muted-foreground mb-4">Trust</p>
      <h1 class="text-[36px] md:text-[48px] font-semibold tracking-tight m-0 mb-6">Licensed & insured</h1>
      <div class="prose prose-lg max-w-none text-foreground">
        <p>
          JT's Heating Cooling & Plumbing is fully licensed and insured in the state of Michigan. It is an owner-operated business — the person you talk to is the person who shows up.
        </p>
        <p>
          Happy to share insurance and licensing paperwork before any job. If you need a certificate for a property manager, HOA, or insurer, ask when you book or call {SITE.phone}.
        </p>
        <p>
          <a href="/book/">Book a visit</a> or <a href="/contact/">send a message</a> and we will get back to you.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
