---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PricingHero from '@/components/pricing/PricingHero.astro';
import PricingReviews from '@/components/pricing/PricingReviews.astro';
import PricingHow from '@/components/pricing/PricingHow.astro';
import PricingTable from '@/components/pricing/PricingTable.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import { localBusiness, offerCatalog, webPage } from '@/config/jsonld';

const title = 'HVAC & Plumbing Quotes | Grand Rapids, MI';
const description =
  'Call for a clear quote on furnace repair, A/C service, heat pumps, mini-splits, and water heater replacement in Grand Rapids and West Michigan.';

const services = (await getCollection('services', ({ data }) => data.draft !== true))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jsonLd = [
  webPage({
    name: title,
    description,
    path: '/pricing/',
  }),
  localBusiness({
    hasOfferCatalog: offerCatalog(
      services.map((entry) => ({
        id: entry.id,
        title: entry.data.title,
        description: entry.data.seoDescription || entry.data.description,
      })),
    ),
  }),
];
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <PricingHero />
  <PricingReviews />
  <PricingHow />
  <PricingTable />
  <FinalCTA />
</BaseLayout>
