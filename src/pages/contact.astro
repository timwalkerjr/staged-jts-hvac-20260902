---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactHero from '@/components/contact/ContactHero.astro';
import ContactReviews from '@/components/contact/ContactReviews.astro';
import ContactDetails from '@/components/contact/ContactDetails.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import { SITE } from '@/config/site';
import { localBusiness, webPage } from '@/config/jsonld';

const title = 'Contact JT | Grand Rapids, MI HVAC & Plumbing';
const description =
  "Get in touch with JT's Heating Cooling & Plumbing. Call (616) 840-3105 or send a message for heating, cooling, and plumbing help in Grand Rapids.";

const jsonLd = [
  webPage({
    type: 'ContactPage',
    name: title,
    description,
    path: '/contact/',
    extra: {
      telephone: SITE.phone,
    },
  }),
  localBusiness(),
];
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <ContactHero />
  <ContactReviews />
  <ContactDetails />
  <ContactForm />
  <FinalCTA />
</BaseLayout>
