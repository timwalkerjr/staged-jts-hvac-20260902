---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReviewsHero from '@/components/reviews/ReviewsHero.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import { localBusiness, reviewNodes, webPage } from '@/config/jsonld';

const title = "Reviews | JT's Heating Cooling & Plumbing, Grand Rapids MI";
const description =
  "Read 31 verified 5.0-star Google reviews for JT's Heating Cooling & Plumbing from homeowners across Grand Rapids and West Michigan.";

const reviews = (await getCollection('reviews')).sort(
  (a, b) => b.data.reviewDate.valueOf() - a.data.reviewDate.valueOf(),
);

const jsonLd = [
  webPage({
    name: title,
    description,
    path: '/reviews/',
  }),
  localBusiness({
    review: reviewNodes(
      reviews.map((entry) => ({
        author: entry.data.author,
        body: entry.data.body,
        rating: entry.data.rating,
        reviewDate: entry.data.reviewDate,
      })),
    ),
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <ReviewsHero />
  <FinalCTA />
</BaseLayout>
