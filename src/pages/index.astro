---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import ServiceTicker from '@/components/home/ServiceTicker.astro';
import ServicesGrid from '@/components/home/ServicesGrid.astro';
import AboutOwner from '@/components/home/AboutOwner.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import PricingTable from '@/components/home/PricingTable.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ServiceAreaGrid from '@/components/home/ServiceAreaGrid.astro';
import FAQ from '@/components/home/FAQ.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/config/site';
import { faqPage, localBusiness, offerCatalog } from '@/config/jsonld';

const services = (await getCollection('services', ({ data }) => data.draft !== true))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jsonLd = [
  localBusiness({
    hasOfferCatalog: offerCatalog(
      services.map((entry) => ({
        id: entry.id,
        title: entry.data.title,
        description: entry.data.seoDescription || entry.data.description,
      })),
    ),
  }),
  faqPage(),
];
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <Hero />
  <ServiceTicker />
  <ServicesGrid />
  <AboutOwner />
  <HowItWorks />
  <PricingTable />
  <Testimonials />
  <ServiceAreaGrid />
  <FAQ />
  <FinalCTA />
</BaseLayout>
